@* src/LifeCrm.Web/Shared/MobileNavItem.razor
   FIXED: Active state uses same normalised logic as NavItem *@
@inject NavigationManager Nav

<a href="@Href" class="lc-bnav-item @(IsActive ? "lc-bnav-item--active" : "")">
    <MudIcon Icon="@Icon" Size="Size.Small" />
    <span class="lc-bnav-item__label">@Label</span>
</a>

@code {
    [Parameter] public string Href       { get; set; } = "/";
    [Parameter] public string Icon       { get; set; } = "";
    [Parameter] public string Label      { get; set; } = "";
    [Parameter] public bool   ExactMatch { get; set; }

    private bool IsActive
    {
        get
        {
            var current = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/');
            var href    = Href.TrimStart('/').TrimEnd('/');

            if (ExactMatch)
                return string.Equals(current, href, StringComparison.OrdinalIgnoreCase)
                    || (href == "" && current == "");

            if (href == "") return false;
            return current.StartsWith(href, StringComparison.OrdinalIgnoreCase)
                && (current.Length == href.Length || current[href.Length] == '/');
        }
    }
}
