@* src/LifeCrm.Web/Components/Dialogs/ContactFormDialog.razor
   FIXED: Added scrollable dialog, proper mobile layout, all fields visible *@
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Style="max-height:90vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_isEdit ? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)"
                     Class="mr-2 mb-n1" />
            @(_isEdit ? "Edit Contact" : "New Contact")
        </MudText>
    </TitleContent>
    <DialogContent>
        <div Style="overflow-y:auto;max-height:calc(90vh - 140px);padding-right:8px;">
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudTextField @bind-Value="_name" Label="Name *" Variant="Variant.Outlined"
                                  Required="true" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="string" @bind-Value="_type" Label="Type *" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Individual")">Individual</MudSelectItem>
                        <MudSelectItem Value="@("Organization")">Organisation</MudSelectItem>
                        <MudSelectItem Value="@("Church")">Church</MudSelectItem>
                        <MudSelectItem Value="@("Foundation")">Foundation</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_email" Label="Email" Variant="Variant.Outlined"
                                  InputType="InputType.Email" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_phone" Label="Phone" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_primaryContactName" Label="Contact Person"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1"
                             Style="font-size:11px;letter-spacing:0.08em;font-weight:600;">ADDRESS</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_addressLine1" Label="Address line 1"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_addressLine2" Label="Address line 2"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_postalCode" Label="Postal code"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_city" Label="City" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField @bind-Value="_stateProvince" Label="Region / State"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_country" Label="Country" Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-1"
                             Style="font-size:11px;letter-spacing:0.08em;font-weight:600;">OTHER</MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_tags" Label="Tags (comma-separated)"
                                  Variant="Variant.Outlined"
                                  HelperText="e.g. donor, volunteer, board-member" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="Notes" Variant="Variant.Outlined"
                                  Lines="3" />
                </MudItem>
                <MudItem xs="12">
                    <MudCheckBox @bind-Value="_emailOptOut"
                                 Label="Opted out of email communications"
                                 Color="Color.Warning" />
                </MudItem>
            </MudGrid>
          </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Submit" Disabled="_saving">
            @(_saving ? "Saving…" : (_isEdit ? "Save Changes" : "Create Contact"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? ContactId { get; set; }

    private bool _isEdit, _saving;
    private string _name = string.Empty, _type = "Individual", _email = string.Empty,
                   _phone = string.Empty, _city = string.Empty, _country = string.Empty,
                   _postalCode = string.Empty, _stateProvince = string.Empty,
                   _addressLine1 = string.Empty, _addressLine2 = string.Empty,
                   _primaryContactName = string.Empty, _tags = string.Empty,
                   _notes = string.Empty;
    private bool _emailOptOut = false;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = ContactId.HasValue;
        if (!_isEdit) return;
        var res = await Api.GetContactAsync(ContactId!.Value);
        if (res.Data is null) return;
        var c = res.Data;
        _name = c.Name; _type = c.Type.ToString(); _email = c.Email ?? string.Empty;
        _phone = c.Phone ?? string.Empty; _city = c.City ?? string.Empty;
        _country = c.Country ?? string.Empty; _postalCode = c.PostalCode ?? string.Empty;
        _stateProvince = c.StateProvince ?? string.Empty;
        _addressLine1 = c.AddressLine1 ?? string.Empty; _addressLine2 = c.AddressLine2 ?? string.Empty;
        _primaryContactName = c.PrimaryContactName ?? string.Empty;
        _tags = c.Tags ?? string.Empty; _notes = c.Notes ?? string.Empty;
        _emailOptOut = c.EmailOptOut;
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Warning); return;
        }
        _saving = true;
        try
        {
            if (_isEdit)
            {
                var req = new UpdateContactRequest
                {
                    Id = ContactId!.Value, Name = _name, Type = Enum.Parse<ContactType>(_type),
                    Email = _email.NullIfEmpty(), Phone = _phone.NullIfEmpty(),
                    City = _city.NullIfEmpty(), Country = _country.NullIfEmpty(),
                    PostalCode = _postalCode.NullIfEmpty(), StateProvince = _stateProvince.NullIfEmpty(),
                    AddressLine1 = _addressLine1.NullIfEmpty(), AddressLine2 = _addressLine2.NullIfEmpty(),
                    PrimaryContactName = _primaryContactName.NullIfEmpty(),
                    Tags = _tags.NullIfEmpty(), Notes = _notes.NullIfEmpty(), EmailOptOut = _emailOptOut
                };
                var res = await Api.UpdateContactAsync(ContactId!.Value, req);
                if (res.Success) { Snackbar.Add("Contact updated.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
            }
            else
            {
                var req = new CreateContactRequest
                {
                    Name = _name, Type = Enum.Parse<ContactType>(_type),
                    Email = _email.NullIfEmpty(), Phone = _phone.NullIfEmpty(),
                    City = _city.NullIfEmpty(), Country = _country.NullIfEmpty(),
                    PostalCode = _postalCode.NullIfEmpty(), StateProvince = _stateProvince.NullIfEmpty(),
                    AddressLine1 = _addressLine1.NullIfEmpty(), AddressLine2 = _addressLine2.NullIfEmpty(),
                    PrimaryContactName = _primaryContactName.NullIfEmpty(),
                    Tags = _tags.NullIfEmpty(), Notes = _notes.NullIfEmpty(), EmailOptOut = _emailOptOut
                };
                var res = await Api.CreateContactAsync(req);
                if (res.Success) { Snackbar.Add("Contact created.", Severity.Success); MudDialog.Close(DialogResult.Ok(res.Data)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
