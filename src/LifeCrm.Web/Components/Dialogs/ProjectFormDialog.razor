@* src/LifeCrm.Web/Components/Dialogs/ProjectFormDialog.razor
   FIXED: Scrollable dialog, English labels, proper mobile layout *@
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Style="max-height:90vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Class="mr-2 mb-n1" />
            @(_isEdit ? "Edit Project" : "New Project")
        </MudText>
    </TitleContent>
    <DialogContent Style="overflow-y:auto;max-height:calc(90vh - 140px);padding-right:8px;">
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_name" Label="Name *" Variant="Variant.Outlined"
                              Required="true" AutoFocus="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_description" Label="Description"
                              Variant="Variant.Outlined" Lines="3" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_location" Label="Location / Country"
                              Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_budgetGoal" Label="Funding Goal"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                 HideSpinButtons="true" Min="0m" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Planning")">Planning</MudSelectItem>
                    <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                    <MudSelectItem Value="@("OnHold")">On Hold</MudSelectItem>
                    <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                    <MudSelectItem Value="@("Archived")">Archived</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_startDate" Label="Start date"
                               Variant="Variant.Outlined" Editable="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_endDate" Label="End date"
                               Variant="Variant.Outlined" Editable="true" Clearable="true" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_notes" Label="Notes"
                              Variant="Variant.Outlined" Lines="2" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Submit" Disabled="_saving">
            @(_saving ? "Saving…" : (_isEdit ? "Save" : "Create"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? ProjectId { get; set; }

    private bool _isEdit, _saving;
    private string _name = string.Empty, _description = string.Empty,
                   _location = string.Empty, _status = "Planning", _notes = string.Empty;
    private decimal? _budgetGoal;
    private DateTime? _startDate, _endDate;

    protected override async Task OnInitializedAsync()
    {
        _isEdit = ProjectId.HasValue;
        if (!_isEdit) return;
        var res = await Api.GetProjectAsync(ProjectId!.Value);
        if (res.Data is null) return;
        var p = res.Data;
        _name = p.Name; _description = p.Description ?? string.Empty;
        _location = p.Location ?? string.Empty; _budgetGoal = p.BudgetGoal;
        _status = p.Status.ToString(); _notes = p.Notes ?? string.Empty;
        _startDate = p.StartDate?.ToDateTime(TimeOnly.MinValue);
        _endDate   = p.EndDate?.ToDateTime(TimeOnly.MinValue);
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_name))
        {
            Snackbar.Add("Name is required.", Severity.Warning); return;
        }
        _saving = true;
        try
        {
            if (_isEdit)
            {
                var req = new UpdateProjectRequest
                {
                    Id = ProjectId!.Value, Name = _name,
                    Description = _description.NullIfEmpty(), Location = _location.NullIfEmpty(),
                    BudgetGoal = _budgetGoal > 0 ? _budgetGoal : null,
                    Status = Enum.Parse<ProjectStatus>(_status),
                    StartDate = _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : null,
                    EndDate   = _endDate.HasValue   ? DateOnly.FromDateTime(_endDate.Value)   : null,
                    Notes = _notes.NullIfEmpty()
                };
                var res = await Api.UpdateProjectAsync(ProjectId!.Value, req);
                if (res.Success) { Snackbar.Add("Project updated.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
            }
            else
            {
                var req = new CreateProjectRequest
                {
                    Name = _name, Description = _description.NullIfEmpty(),
                    Location = _location.NullIfEmpty(),
                    BudgetGoal = _budgetGoal > 0 ? _budgetGoal : null,
                    Status = Enum.Parse<ProjectStatus>(_status),
                    StartDate = _startDate.HasValue ? DateOnly.FromDateTime(_startDate.Value) : null,
                    EndDate   = _endDate.HasValue   ? DateOnly.FromDateTime(_endDate.Value)   : null,
                    Notes = _notes.NullIfEmpty()
                };
                var res = await Api.CreateProjectAsync(req);
                if (res.Success) { Snackbar.Add("Project created.", Severity.Success); MudDialog.Close(DialogResult.Ok(res.Data)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
