@* src/LifeCrm.Web/Components/Dialogs/UserFormDialog.razor *@
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@(_isEdit? Icons.Material.Filled.Edit : Icons.Material.Filled.PersonAdd)"
                     Class="mr-2 mb-n1" />
            @(_isEdit ? "Redigera användare" : "Ny användare")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12">
                <MudTextField @bind-Value="_fullName" Label="Fullständigt namn *"
                              Variant="Variant.Outlined" />
            </MudItem>
            @if (!_isEdit)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_email" Label="E-post *"
                                  Variant="Variant.Outlined" InputType="InputType.Email" />
                </MudItem>
            }
            else
            {
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">E-post: @ExistingUser?.Email</MudText>
                </MudItem>
            }
            <MudItem xs="12">
                <MudSelect T="UserRole" @bind-Value="_role" Label="Roll *" Variant="Variant.Outlined">
                    @foreach (UserRole r in Enum.GetValues<UserRole>())
                    {
                        <MudSelectItem Value="r">@r</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_password"
                              Label="@(_isEdit ? "Nytt lösenord (lämna tomt för att behålla)" : "Lösenord *")"
                              InputType="@(_showPw? InputType.Text: InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPw? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _showPw = !_showPw)"
                              HelperText="Minst 10 tecken" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Avbryt</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="Submit" Disabled="_saving">
            @(_saving ? "Sparar…" : (_isEdit ? "Spara" : "Skapa"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Guid? UserId { get; set; }
    [Parameter] public UserSummaryDto? ExistingUser { get; set; }

    private bool _isEdit => UserId.HasValue;
    private string _fullName = string.Empty, _email = string.Empty, _password = string.Empty;
    private UserRole _role = UserRole.Manager;
    private bool _saving, _showPw;

    protected override void OnInitialized()
    {
        if (ExistingUser is not null)
        {
            _fullName = ExistingUser.FullName;
            _role = ExistingUser.Role;
        }
    }

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_fullName))
        {
            Snackbar.Add("Namn krävs.", Severity.Warning); return;
        }
        if (!_isEdit && string.IsNullOrWhiteSpace(_email))
        {
            Snackbar.Add("E-post krävs.", Severity.Warning); return;
        }
        if (!_isEdit && (_password.Length < 10))
        {
            Snackbar.Add("Lösenord måste vara minst 10 tecken.", Severity.Warning); return;
        }
        if (_isEdit && !string.IsNullOrEmpty(_password) && _password.Length < 10)
        {
            Snackbar.Add("Lösenord måste vara minst 10 tecken.", Severity.Warning); return;
        }

        _saving = true;
        try
        {
            if (_isEdit)
            {
                var req = new UpdateUserRequest
                {
                    FullName = _fullName,
                    NewPassword = string.IsNullOrWhiteSpace(_password) ? null : _password,
                    Role = _role
                };
                var res = await Api.UpdateUserAsync(UserId!.Value, req);
                if (res.Success) { Snackbar.Add("Uppdaterad.", Severity.Success); MudDialog.Close(DialogResult.Ok(true)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Fel.", Severity.Error);
            }
            else
            {
                var req = new CreateUserRequest
                {
                    FullName = _fullName,
                    Email = _email,
                    Password = _password,
                    Role = _role
                };
                var res = await Api.CreateUserAsync(req);
                if (res.Success) { Snackbar.Add("Användare skapad.", Severity.Success); MudDialog.Close(DialogResult.Ok(res.Data)); }
                else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Fel.", Severity.Error);
            }
        }
        finally { _saving = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}