@* src/LifeCrm.Web/Components/Dialogs/SendEmailToContactDialog.razor
   FIXED: Scrollable dialog content *@
@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog Style="max-height:90vh;">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2 mb-n1" />
            Send email to @ContactName
        </MudText>
    </TitleContent>
    <DialogContent Style="overflow-y:auto;max-height:calc(90vh - 140px);padding-right:8px;">
        @if (string.IsNullOrEmpty(ContactEmail))
        {
            <MudAlert Severity="Severity.Warning">
                This contact has no email address registered.
            </MudAlert>
        }
        else
        {
            @if (EmailOptOut)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3">
                    This contact has opted out of emails. You are sending a direct message anyway.
                </MudAlert>
            }
            <MudGrid Spacing="2">
                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        To: <b>@ContactName &lt;@ContactEmail&gt;</b>
                    </MudText>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_subject" Label="Subject *"
                                  Variant="Variant.Outlined" AutoFocus="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_body" Label="Message *"
                                  Variant="Variant.Outlined" Lines="8"
                                  Placeholder="Write your message here. HTML tags are supported." />
                </MudItem>
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        @if (!string.IsNullOrEmpty(ContactEmail))
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       OnClick="Send" Disabled="_sending">
                @(_sending ? "Sending…" : "Send")
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string  ContactName  { get; set; } = string.Empty;
    [Parameter] public string? ContactEmail { get; set; }
    [Parameter] public bool    EmailOptOut  { get; set; }

    private string _subject = string.Empty, _body = string.Empty;
    private bool _sending;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_subject))
        {
            Snackbar.Add("Subject is required.", Severity.Warning); return;
        }
        if (string.IsNullOrWhiteSpace(_body))
        {
            Snackbar.Add("Message body is required.", Severity.Warning); return;
        }

        _sending = true;
        try
        {
            var res = await Api.SendDirectEmailAsync(
                ContactEmail!, ContactName, _subject, _body);

            if (res.Success && res.Data?.StartsWith("Send failed") != true)
            {
                Snackbar.Add("Email sent.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(res.Data ?? res.Errors.FirstOrDefault() ?? "Send failed.", Severity.Error);
            }
        }
        finally { _sending = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
