@inject ApiClient Api
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Email" Class="mr-2 mb-n1" />
            Skicka e-post till @ContactName
        </MudText>
    </TitleContent>
    <DialogContent>
        @if (string.IsNullOrEmpty(ContactEmail))
        {
            <MudAlert Severity="Severity.Warning">Kontakten har ingen e-postadress registrerad.</MudAlert>
        }
        else if (EmailOptOut)
        {
            <MudAlert Severity="Severity.Warning">
                Kontakten har avsagt sig e-post. Du kan ändå skicka ett direkt meddelande om det är nödvändigt.
            </MudAlert>
        }
        <MudGrid Spacing="2" Class="mt-2">
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Till: <b>@ContactEmail</b>
                </MudText>
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_subject" Label="Ämne *" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_body" Label="Meddelande *" Variant="Variant.Outlined" Lines="6"
                              Placeholder="Skriv ditt meddelande här. Du kan använda HTML-taggar." />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Avbryt</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Send"
                   Disabled="@(_sending || string.IsNullOrEmpty(ContactEmail))">
            @(_sending ? "Skickar…" : "Skicka")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string  ContactName  { get; set; } = string.Empty;
    [Parameter] public string? ContactEmail { get; set; }
    [Parameter] public bool    EmailOptOut  { get; set; }

    private string _subject = string.Empty, _body = string.Empty;
    private bool _sending;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_subject)) { Snackbar.Add("Ämne krävs.", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_body))    { Snackbar.Add("Meddelande krävs.", Severity.Warning); return; }
        if (string.IsNullOrEmpty(ContactEmail))  { Snackbar.Add("Ingen e-postadress.", Severity.Error); return; }

        _sending = true;
        try
        {
            var res = await Api.SendDirectEmailAsync(ContactEmail, ContactName, _subject, _body);
            if (res.Success)
            {
                Snackbar.Add("E-post skickad.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Fel vid sändning.", Severity.Error);
        }
        finally { _sending = false; }
    }

    private void Cancel() => MudDialog.Cancel();
}
