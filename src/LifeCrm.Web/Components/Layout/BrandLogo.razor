@* src/LifeCrm.Web/Components/Layout/BrandLogo.razor
   Renders the logotype in full or icon-only mode.
   To use your own logo: replace wwwroot/brand/logo.svg (full) and
   wwwroot/brand/logo-icon.svg (icon). The SVG placeholder is shown until you do.
*@

@if (IconOnly)
{
    <img src="brand/logo-icon.svg"
         alt="LifeCrm"
         width="32" height="32"
         style="display:block;flex-shrink:0;"
         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
    <!-- Fallback: brand initial badge -->
    <div style="display:none;width:32px;height:32px;border-radius:8px;
                background:rgba(255,255,255,0.15);color:white;
                align-items:center;justify-content:center;
                font-size:14px;font-weight:700;flex-shrink:0;">L</div>
}
else
{
    <div style="display:flex;align-items:center;gap:10px;min-width:0;">
        <img src="brand/logo.svg"
             alt="LifeCrm"
             height="36"
             style="display:block;flex-shrink:0;max-width:160px;"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <!-- Fallback: icon + text -->
        <div style="display:none;align-items:center;gap:8px;">
            <div style="width:32px;height:32px;border-radius:8px;
                        background:rgba(255,255,255,0.15);color:white;
                        display:flex;align-items:center;justify-content:center;
                        font-size:14px;font-weight:700;flex-shrink:0;">L</div>
            <span style="font-size:15px;font-weight:700;color:white;
                         letter-spacing:-0.02em;white-space:nowrap;">LifeCrm</span>
        </div>
    </div>
}

@code {
    /// <summary>
    /// True = icon-only mark (32×32). False = full horizontal logo (default).
    /// </summary>
    [Parameter] public bool IconOnly { get; set; } = false;
}
