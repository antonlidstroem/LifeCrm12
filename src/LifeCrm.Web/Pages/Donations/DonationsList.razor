@* src/LifeCrm.Web/Pages/Donations/DonationsList.razor *@
@page "/donations"
@using LifeCrm.Web.Services
@using LifeCrm.Web.Shared
@using LifeCrm.Application.Common.DTOs
@using LifeCrm.Application.Donations.DTOs
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Donations — LifeCrm</PageTitle>

<div class="lc-page-enter">
    <PageHeader Title="Donations"
                Subtitle="@(_totalCount > 0 ? $"{_totalCount:N0} records · ${_totalAmount:N0} total shown" : null)">
        <Actions>
            @if (AppState.IsFinanceOrAdmin)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.AddCard"
                           Href="/donations/new">
                    Record Donation
                </MudButton>
            }
        </Actions>
    </PageHeader>

    <!-- Filter bar -->
    <div class="lc-filter-bar">
        <div class="lc-search">
            <MudIcon Icon="@Icons.Material.Outlined.Search"
                     Size="Size.Small" Class="lc-search__icon" />
            <input class="lc-search__input" placeholder="Search contact or reference…"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
        </div>

        <MudDatePicker @bind-Date="_fromDate" Label="From" Variant="Variant.Outlined"
                       DateFormat="yyyy-MM-dd" Clearable="true"
                       Class="lc-filter-date" Editable="true"
                       AdornmentColor="Color.Default"
                       PickerVariant="PickerVariant.Dialog" />

        <MudDatePicker @bind-Date="_toDate" Label="To" Variant="Variant.Outlined"
                       DateFormat="yyyy-MM-dd" Clearable="true"
                       Class="lc-filter-date" Editable="true"
                       AdornmentColor="Color.Default"
                       PickerVariant="PickerVariant.Dialog" />

        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.FilterAlt"
                   OnClick="ApplyFilters">
            Apply
        </MudButton>

        @if (HasFilters)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       OnClick="ClearFilters">
                Clear
            </MudButton>
        }
    </div>

    <DataCard>
        <!-- Desktop table -->
        <div class="lc-hide-mobile">
            <MudTable Items="_donations" Dense="true" Hover="true"
                      Loading="_loading" LoadingProgressColor="Color.Primary"
                      FixedHeader="true" Height="calc(100vh - 320px)"
                      OnRowClick="@((TableRowClickEventArgs<DonationListDto> e) => GoTo(e.Item))"
                      Style="cursor:pointer;">
                <HeaderContent>
                    <MudTh>Contact</MudTh>
                    <MudTh Style="text-align:right">Amount</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Class="lc-hide-md">Campaign</MudTh>
                    <MudTh Class="lc-hide-md">Method</MudTh>
                    <MudTh Style="width:100px">Receipt</MudTh>
                    <MudTh Style="width:48px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Contact">
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div class="lc-contact-avatar">
                                @(context.ContactName.Length > 0 ? context.ContactName[0].ToString().ToUpper() : "?")
                            </div>
                            <span style="font-weight:500">@context.ContactName</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Amount" Style="text-align:right;">
                        <span class="lc-col-amount">$@context.Amount.ToString("N2")</span>
                    </MudTd>
                    <MudTd DataLabel="Date">
                        <span class="lc-col-date">@context.Date.ToString("yyyy-MM-dd")</span>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusBadge Text="@context.Status.ToString()"
                                     Variant="@StatusBadge.VariantFromDonationStatus(context.Status)" />
                    </MudTd>
                    <MudTd DataLabel="Campaign" Class="lc-hide-md lc-muted"
                           Style="font-size:12px;">
                        @context.CampaignName
                    </MudTd>
                    <MudTd DataLabel="Method" Class="lc-hide-md lc-muted"
                           Style="font-size:12px;">
                        @context.PaymentMethod
                    </MudTd>
                    <MudTd DataLabel="Receipt">
                        @if (context.ReceiptSent && context.ReceiptDocumentId.HasValue)
                        {
                            <MudTooltip Text="Download receipt">
                                <MudIconButton Icon="@Icons.Material.Outlined.Receipt"
                                               Size="Size.Small" Color="Color.Success"
                                               OnClick="@(async () => await DownloadReceipt(context))"
                                               @onclick:stopPropagation="true" />
                            </MudTooltip>
                        }
                        else if (AppState.IsFinanceOrAdmin)
                        {
                            <MudTooltip Text="Generate receipt">
                                <MudIconButton Icon="@Icons.Material.Outlined.ReceiptLong"
                                               Size="Size.Small" Color="Color.Default"
                                               OnClick="@(async () => await GenerateReceipt(context))"
                                               @onclick:stopPropagation="true" />
                            </MudTooltip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                       Size="Size.Small"
                                       OnClick="@(() => GoTo(context))"
                                       @onclick:stopPropagation="true" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="lc-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.VolunteerActivism"
                                 Style="font-size:40px;color:var(--lc-text-disabled)" />
                        <span class="lc-empty__title">No donations found</span>
                        <span class="lc-empty__subtitle">
                            @(HasFilters ? "Try adjusting your filters." : "Record your first donation to get started.")
                        </span>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>

        <!-- Mobile card list -->
        <div class="lc-show-mobile lc-card-list" style="padding:8px;">
            @if (_loading)
            {
                @for (int i = 0; i < 5; i++)
                {
                    <div class="lc-skeleton-row" style="height:88px;"></div>
                }
            }
            else
            {
                @foreach (var d in _donations)
                {
                    <div class="lc-list-card" @onclick="() => GoTo(d)">
                        <div class="lc-list-card__header">
                            <span class="lc-list-card__title">@d.ContactName</span>
                            <StatusBadge Text="@d.Status.ToString()"
                                         Variant="@StatusBadge.VariantFromDonationStatus(d.Status)" />
                        </div>
                        <div class="lc-list-card__meta">
                            <span class="lc-mono" style="color:var(--lc-text-primary);font-weight:500;">
                                $@d.Amount.ToString("N2")
                            </span>
                            <span class="lc-list-card__meta-item lc-col-date">
                                @d.Date.ToString("yyyy-MM-dd")
                            </span>
                            @if (!string.IsNullOrEmpty(d.CampaignName))
                            {
                                <span class="lc-list-card__meta-item lc-muted">
                                    @d.CampaignName
                                </span>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <div class="lc-table-footer">
            <span class="lc-muted" style="font-size:12px;">
                Showing @_donations.Count of @_totalCount
            </span>
            <MudPagination Count="_totalPages" Selected="_page"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary" Size="Size.Small" />
        </div>
    </DataCard>
</div>

<style>
    .lc-filter-bar {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }
    .lc-filter-date { max-width: 150px; }
    .lc-contact-avatar {
        width: 28px; height: 28px; border-radius: 50%;
        background: var(--lc-accent-dim); border: 1px solid var(--lc-accent);
        display: flex; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 600; color: var(--lc-accent); flex-shrink: 0;
    }
    .lc-hide-md { }
    @media (max-width: 1100px) { .lc-hide-md { display: none !important; } }
    @media (max-width: 768px) {
        .lc-filter-bar { gap: 8px; }
        .lc-filter-date { max-width: 130px; }
    }
</style>

@code {
    private List<DonationListDto> _donations = new();
    private bool     _loading    = true;
    private string?  _search;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int      _page       = 1;
    private int      _totalCount = 0;
    private int      _totalPages = 1;
    private decimal  _totalAmount = 0;
    private const int PageSize = 25;

    private bool HasFilters => !string.IsNullOrWhiteSpace(_search)
                            || _fromDate.HasValue || _toDate.HasValue;

    private System.Timers.Timer? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        DateOnly? from = _fromDate.HasValue ? DateOnly.FromDateTime(_fromDate.Value) : null;
        DateOnly? to   = _toDate.HasValue   ? DateOnly.FromDateTime(_toDate.Value)   : null;

        var resp = await Api.GetDonationsAsync(
            new PaginationParams { Page = _page, PageSize = PageSize, Search = _search },
            fromDate: from, toDate: to);

        if (resp.Success && resp.Data is not null)
        {
            _donations   = resp.Data.Items.ToList();
            _totalCount  = resp.Data.TotalCount;
            _totalPages  = resp.Data.TotalPages;
            _totalAmount = _donations.Sum(d => d.Amount);
        }
        _loading = false;
    }

    private void OnSearchKey(KeyboardEventArgs _)
    {
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350);
        _debounce.Elapsed += async (_, _) =>
        {
            _debounce?.Dispose();
            _page = 1;
            await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        };
        _debounce.AutoReset = false;
        _debounce.Start();
    }

    private async Task ApplyFilters() { _page = 1; await LoadAsync(); }
    private async Task ClearFilters()
    {
        _search = null; _fromDate = null; _toDate = null; _page = 1;
        await LoadAsync();
    }

    private async Task OnPageChanged(int p) { _page = p; await LoadAsync(); }
    private void GoTo(DonationListDto d) => Nav.NavigateTo($"/donations/{d.Id}");

    private async Task GenerateReceipt(DonationListDto d)
    {
        var resp = await Api.GenerateReceiptAsync(d.Id, sendByEmail: false);
        if (resp.Success)
        {
            Snackbar.Add("Receipt generated.", Severity.Success);
            await LoadAsync();
        }
        else Snackbar.Add(resp.Errors.FirstOrDefault() ?? "Failed.", Severity.Error);
    }

    private async Task DownloadReceipt(DonationListDto d)
    {
        if (!d.ReceiptDocumentId.HasValue) return;
        var resp = await Api.DownloadReceiptAsync(d.Id, d.ReceiptDocumentId.Value);
        if (!resp.Success) Snackbar.Add("Download failed.", Severity.Error);
    }
}
