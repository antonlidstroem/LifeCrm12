@* src/LifeCrm.Web/Pages/Interactions/InteractionsList.razor *@
@page "/interactions"
@using LifeCrm.Web.Services
@using LifeCrm.Web.Shared
@using LifeCrm.Contracts.Common.DTOs
@using LifeCrm.Contracts.Interactions.DTOs
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Interactions — LifeCrm</PageTitle>

<div class="lc-page-enter">
    <PageHeader Title="Interactions"
                Subtitle="@(_totalCount > 0 ? $"{_totalCount:N0} logged interactions" : null)">
        <Actions>
            @if (AppState.CanWrite)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.AddComment"
                           OnClick="OpenCreateDialog">
                    Log Interaction
                </MudButton>
            }
        </Actions>
    </PageHeader>

    <div class="lc-filter-bar">
        <div class="lc-search" style="min-width:280px;">
            <MudIcon Icon="@Icons.Material.Outlined.Search" Size="Size.Small" Class="lc-search__icon" />
            <input class="lc-search__input" placeholder="Search subject, body, contact…"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
        </div>

        <MudSelect T="string" @bind-Value="_typeFilter" Label="Type" Variant="Variant.Outlined"
                   Style="min-width:140px;" Dense="true" Margin="Margin.Dense" Clearable="true">
            <MudSelectItem Value="@("")">All types</MudSelectItem>
            <MudSelectItem Value="@("Call")">Call</MudSelectItem>
            <MudSelectItem Value="@("Email")">Email</MudSelectItem>
            <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
            <MudSelectItem Value="@("Note")">Note</MudSelectItem>
            <MudSelectItem Value="@("Other")">Other</MudSelectItem>
        </MudSelect>

        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                   StartIcon="@Icons.Material.Outlined.FilterAlt"
                   OnClick="ApplyFilters">Apply</MudButton>

        @if (HasFilters)
        {
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       StartIcon="@Icons.Material.Outlined.FilterAltOff"
                       OnClick="ClearFilters">Clear</MudButton>
        }
    </div>

    <DataCard>
        <div class="lc-hide-mobile">
            <MudTable Items="_interactions" Dense="true" Hover="true"
                      Loading="_loading" LoadingProgressColor="Color.Primary"
                      FixedHeader="true" Height="calc(100vh - 300px)">
                <HeaderContent>
                    <MudTh>Type</MudTh>
                    <MudTh>Contact / Project</MudTh>
                    <MudTh>Subject</MudTh>
                    <MudTh>Body</MudTh>
                    <MudTh>Date</MudTh>
                    <MudTh>By</MudTh>
                    <MudTh Style="width:80px"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Type">
                        <StatusBadge Text="@context.Type.ToString()" Variant="@TypeBadge(context.Type)" />
                    </MudTd>
                    <MudTd DataLabel="Contact">
                        @if (context.ContactId.HasValue)
                        {
                            <MudLink Href="@($"/contacts/{context.ContactId}")">@context.ContactName</MudLink>
                        }
                        else if (context.ProjectId.HasValue)
                        {
                            <MudLink Href="@($"/projects/{context.ProjectId}")">@context.ProjectName</MudLink>
                        }
                        else
                        {
                            <span class="lc-muted">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Subject" Style="font-size:13px;">
                        @(string.IsNullOrEmpty(context.Subject) ? "—" : context.Subject)
                    </MudTd>
                    <MudTd DataLabel="Body" Style="font-size:12px;color:var(--lc-text-secondary);max-width:260px;">
                        <div style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            @context.Body
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Date">
                        <span class="lc-col-date">@context.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd")</span>
                    </MudTd>
                    <MudTd DataLabel="By" Style="font-size:12px;" Class="lc-muted">
                        @context.CreatedByName
                    </MudTd>
                    <MudTd>
                        <div style="display:flex;gap:2px;" @onclick:stopPropagation="true">
                            @if (AppState.CanWrite)
                            {
                                <MudTooltip Text="Edit">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                   Size="Size.Small"
                                                   OnClick="@(() => OpenEditDialog(context))" />
                                </MudTooltip>
                            }
                            @if (AppState.IsAdmin)
                            {
                                <MudTooltip Text="Delete">
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(context))" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="lc-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Forum"
                                 Style="font-size:40px;color:var(--lc-text-disabled)" />
                        <span class="lc-empty__title">No interactions found</span>
                        <span class="lc-empty__subtitle">
                            @(HasFilters ? "Try adjusting your filters." : "Log your first interaction to get started.")
                        </span>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </div>

        <div class="lc-show-mobile lc-card-list" style="padding:8px;">
            @if (_loading)
            {
                @for (int i = 0; i < 5; i++)
                {
                    <div class="lc-skeleton-row" style="height:88px;"></div>
                }
            }
            else
            {
                @foreach (var i in _interactions)
                {
                    <div class="lc-list-card">
                        <div class="lc-list-card__header">
                            <StatusBadge Text="@i.Type.ToString()" Variant="@TypeBadge(i.Type)" />
                            <span class="lc-col-date" style="font-size:12px;">
                                @i.OccurredAt.LocalDateTime.ToString("yyyy-MM-dd")
                            </span>
                        </div>
                        <div class="lc-list-card__meta">
                            @if (!string.IsNullOrEmpty(i.ContactName))
                            {
                                <span style="font-weight:500;">@i.ContactName</span>
                            }
                            @if (!string.IsNullOrEmpty(i.Subject))
                            {
                                <span>@i.Subject</span>
                            }
                        </div>
                        <div style="font-size:12px;color:var(--lc-text-secondary);margin-top:4px;
                                    overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                            @i.Body
                        </div>
                        @if (AppState.CanWrite)
                        {
                            <div style="display:flex;gap:4px;justify-content:flex-end;margin-top:6px;">
                                <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                               Size="Size.Small"
                                               OnClick="@(() => OpenEditDialog(i))" />
                                @if (AppState.IsAdmin)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline"
                                                   Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(i))" />
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        <div class="lc-table-footer">
            <span class="lc-muted" style="font-size:12px;">@_interactions.Count of @_totalCount</span>
            <MudPagination Count="_totalPages" Selected="_page"
                           SelectedChanged="OnPageChanged"
                           Color="Color.Primary" Size="Size.Small" />
        </div>
    </DataCard>
</div>

@code {
    private List<InteractionDto> _interactions = new();
    private bool    _loading     = true;
    private string? _search;
    private string  _typeFilter  = string.Empty;
    private int     _page        = 1;
    private int     _totalCount  = 0;
    private int     _totalPages  = 1;
    private const int PageSize   = 25;
    private System.Timers.Timer? _debounce;

    private bool HasFilters => !string.IsNullOrWhiteSpace(_search)
                            || !string.IsNullOrWhiteSpace(_typeFilter);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var url = $"api/v1/interactions?page={_page}&pageSize={PageSize}";
        if (!string.IsNullOrWhiteSpace(_search))
            url += $"&search={Uri.EscapeDataString(_search)}";
        if (!string.IsNullOrWhiteSpace(_typeFilter))
            url += $"&type={Uri.EscapeDataString(_typeFilter)}";

        var resp = await Api.GetInteractionsListAsync(
            new PaginationParams { Page = _page, PageSize = PageSize, Search = _search },
            _typeFilter.NullIfEmpty());

        if (resp.Success && resp.Data is not null)
        {
            _interactions = resp.Data.Items.ToList();
            _totalCount   = resp.Data.TotalCount;
            _totalPages   = resp.Data.TotalPages;
        }
        _loading = false;
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions
        {
            CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true,
            BackdropClick = false, CloseOnEscapeKey = true
        };
        var d = DialogService.Show<LogInteractionDialog>("Log Interaction", new DialogParameters(), options);
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task OpenEditDialog(InteractionDto interaction)
    {
        var options = new DialogOptions
        {
            CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true,
            BackdropClick = false, CloseOnEscapeKey = true
        };
        var p = new DialogParameters
        {
            ["ContactId"]     = interaction.ContactId,
            ["ProjectId"]     = interaction.ProjectId,
            ["InteractionId"] = (Guid?)interaction.Id
        };
        var d = DialogService.Show<LogInteractionDialog>("Edit Interaction", p, options);
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task DeleteAsync(InteractionDto i)
    {
        var p = new DialogParameters
        {
            ["Title"]   = "Delete Interaction",
            ["Message"] = "Delete this interaction? This cannot be undone."
        };
        var confirm = DialogService.Show<ConfirmDialog>("", p);
        if ((await confirm.Result).Canceled) return;
        var res = await Api.DeleteInteractionAsync(i.Id);
        if (res.Success) { Snackbar.Add("Deleted.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }

    private async Task ApplyFilters() { _page = 1; await LoadAsync(); }
    private async Task ClearFilters() { _search = null; _typeFilter = string.Empty; _page = 1; await LoadAsync(); }

    private void OnSearchKey(KeyboardEventArgs _)
    {
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350);
        _debounce.Elapsed += async (_, _) =>
        {
            _debounce?.Dispose(); _page = 1;
            await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        };
        _debounce.AutoReset = false; _debounce.Start();
    }

    private async Task OnPageChanged(int p) { _page = p; await LoadAsync(); }

    private static string TypeBadge(InteractionType t) => t switch
    {
        InteractionType.Call    => "info",
        InteractionType.Email   => "primary",
        InteractionType.Meeting => "success",
        InteractionType.Note    => "neutral",
        _                       => "neutral"
    };
}
