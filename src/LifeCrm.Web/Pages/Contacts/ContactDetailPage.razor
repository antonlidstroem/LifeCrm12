@page "/contacts/{Id:guid}"
@inject ContactsApiClient ContactsApi
@inject DonationsApiClient DonationsApi
@inject InteractionsApiClient InteractionsApi
@inject EventsApiClient EventsApi
@inject AppState AppState
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => Nav.NavigateTo("/contacts"))" />
    <MudText Typo="Typo.h5">@(_contact?.FullName ?? "Laddar…")</MudText>
    <MudSpacer />
    @if (AppState.CanWrite && _contact is not null && !_contact.IsAnonymized)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit"
                   OnClick="OpenEditDialog" Class="mr-2">Redigera</MudButton>
    }
    @if (AppState.IsFinanceOrAdmin && _contact is not null && !string.IsNullOrEmpty(_contact.Email))
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Email"
                   OnClick="OpenSendEmailDialog">Skicka e-post</MudButton>
    }
</MudStack>

@if (_loading) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" /> }
else if (_contact is not null)
{
    @if (_contact.IsAnonymized)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" Size="Size.Small" Class="mr-1 mb-n1" />
            This contact has been anonymized (GDPR erasure). PII has been removed.
            @if (_contact.AnonymizedAt.HasValue)
            {
                <text> Anonymized on @_contact.AnonymizedAt.Value.ToLocalTime().ToString("yyyy-MM-dd").</text>
            }
        </MudAlert>
    }

    <MudGrid>
        <!-- Left column: contact card + GDPR + Profile panels -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudStack AlignItems="AlignItems.Center" Class="mb-4">
                        <MudAvatar Color="Color.Primary" Style="height:90px;width:90px;font-size:2rem;">
                            @_contact.FirstName[0]
                        </MudAvatar>
                        <MudText Typo="Typo.h5" Class="mt-3">@_contact.FullName</MudText>
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">
                            @_contact.Type
                        </MudChip>
                        @if (!string.IsNullOrEmpty(_contact.Source))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">via @_contact.Source</MudText>
                        }
                    </MudStack>
                    <MudDivider Class="my-3" />
                    <MudList T="string" Dense="true">
                        @if (!string.IsNullOrEmpty(_contact.Email))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.Email">@_contact.Email</MudListItem>
                        }
                        @if (!string.IsNullOrEmpty(_contact.Phone))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.Phone">@_contact.Phone</MudListItem>
                        }
                        @if (!string.IsNullOrEmpty(_contact.City) || !string.IsNullOrEmpty(_contact.Country))
                        {
                            <MudListItem Icon="@Icons.Material.Filled.LocationOn">
                                @string.Join(", ", new[] { _contact.City, _contact.Country }
                                    .Where(s => !string.IsNullOrEmpty(s)))
                            </MudListItem>
                        }
                        @if (_contact.EmailOptOut)
                        {
                            <MudListItem Icon="@Icons.Material.Outlined.Unsubscribe">
                                <MudText Color="Color.Warning" Typo="Typo.body2">Avsagt e-post</MudText>
                            </MudListItem>
                        }
                    </MudList>
                    @if (!string.IsNullOrEmpty(_contact.Notes))
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Anteckningar</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1" Style="white-space:pre-wrap">@_contact.Notes</MudText>
                    }
                    <MudDivider Class="my-3" />
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Events</MudText>
                            <MudText Typo="Typo.h6">@(_engagement?.TotalEvents ?? 0)</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Gåvor</MudText>
                            <MudText Typo="Typo.h6">@_contact.DonationCount</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Totalt</MudText>
                            <MudText Typo="Typo.h6">$@_contact.TotalDonated.ToString("N0")</MudText>
                        </div>
                    </MudStack>
                    @if (_engagement is not null)
                    {
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="mt-2"
                                 Color="@SegmentColor(_engagement.EngagementSegment)">
                            @_engagement.EngagementSegment
                        </MudChip>
                    }
                    @if (AppState.IsFinanceOrAdmin)
                    {
                        <MudDivider Class="my-3" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AddCard"
                                   FullWidth="true" OnClick="OpenDonationDialog" Class="mb-2">
                            Registrera gåva
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Summarize"
                                   FullWidth="true" OnClick="OpenDonationSummaryDialog">
                            Generera årsbesked
                        </MudButton>
                    }
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Skapad @_contact.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")
                    </MudText>
                </MudCardContent>
            </MudCard>

            <!-- GDPR panel (Finance+Admin) -->
            <GdprContactPanel ContactId="Id" OnAnonymized="OnContactAnonymized" />

            <!-- Admin enrichment panel -->
            @if (AppState.IsAdmin)
            {
                <CascadingValue Value="AppState">
                    <ProfilePanel ContactId="Id" />
                </CascadingValue>
            }
        </MudItem>

        <!-- Right column: tabs -->
        <MudItem xs="12" md="8">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

                <!-- Engagement tab (NEW) -->
                <MudTabPanel Text="Engagement" Icon="@Icons.Material.Filled.Event">
                    @if (AppState.CanWrite)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Event"
                                   Size="Size.Small" Class="mb-4"
                                   Href="/events">View all events to check in</MudButton>
                    }
                    @if (_engagement is null || (!_engagement.RecentEvents.Any() && _engagement.TotalDonations == 0))
                    {
                        <EmptyState Title="No engagement recorded"
                                    Icon="@Icons.Material.Outlined.Timeline"
                                    Description="Check this contact in to an event or record a donation to start tracking engagement." />
                    }
                    else
                    {
                        @if (_engagement.RecentEvents.Any())
                        {
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Recent Events</MudText>
                            @foreach (var ev in _engagement.RecentEvents)
                            {
                                <MudPaper Elevation="0" Class="pa-3 mb-2"
                                          Style="border:1px solid var(--mud-palette-divider);border-radius:6px">
                                    <MudStack Row="true" AlignItems="AlignItems.Center">
                                        <MudIcon Icon="@Icons.Material.Filled.Event"
                                                 Color="Color.Primary" Size="Size.Small" />
                                        <div style="flex:1">
                                            <MudLink Href="@($"/events/{ev.EventId}")"
                                                     Typo="Typo.body2">@ev.EventTitle</MudLink>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @ev.StartsAt.ToLocalTime().ToString("yyyy-MM-dd") · @ev.Role
                                            </MudText>
                                        </div>
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text">
                                            @ev.Type
                                        </MudChip>
                                    </MudStack>
                                </MudPaper>
                            }
                        }
                    }
                </MudTabPanel>

                <!-- Interactions tab -->
                <MudTabPanel Text="Tidslinje" Icon="@Icons.Material.Filled.History">
                    @if (AppState.CanWrite)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                                   Size="Size.Small" Class="mb-4" OnClick="OpenLogInteractionDialog">
                            Logga interaktion
                        </MudButton>
                    }
                    @if (!_interactions.Any())
                    {
                        <EmptyState Title="Inga interaktioner" Icon="@Icons.Material.Outlined.History" />
                    }
                    else
                    {
                        <MudTimeline TimelinePosition="TimelinePosition.Start">
                            @foreach (var i in _interactions.OrderByDescending(x => x.OccurredAt))
                            {
                                <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                    <ItemContent>
                                        <MudStack Row="true" AlignItems="AlignItems.Start">
                                            <div style="flex:1">
                                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@i.Type</MudChip>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@i.OccurredAt.ToLocalTime().ToString("g")</MudText>
                                                    @if (!string.IsNullOrEmpty(i.Subject))
                                                    {
                                                        <MudText Typo="Typo.caption"><b>@i.Subject</b></MudText>
                                                    }
                                                </MudStack>
                                                <MudText Typo="Typo.body2" Style="white-space:pre-wrap">@i.Body</MudText>
                                            </div>
                                            @if (AppState.CanWrite)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Size="Size.Small" Color="Color.Error"
                                                               OnClick="@(() => DeleteInteraction(i.Id))" />
                                            }
                                        </MudStack>
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    }
                </MudTabPanel>

                <!-- Donations tab -->
                <MudTabPanel Text="@($"Gåvor ({_donations.Count()})")" Icon="@Icons.Material.Filled.AttachMoney">
                    @if (!_donations.Any())
                    {
                        <EmptyState Title="Inga gåvor registrerade" Icon="@Icons.Material.Outlined.AttachMoney" />
                    }
                    else
                    {
                        <MudTable T="DonationListDto" Items="_donations" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Datum</MudTh><MudTh>Belopp</MudTh><MudTh>Kampanj</MudTh><MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd>$@context.Amount.ToString("N2")</MudTd>
                                <MudTd>@(context.CampaignName ?? context.ProjectName ?? "—")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@context.Status.ToMudColor()">@context.Status</MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ContactDto?                    _contact;
    private IReadOnlyList<DonationListDto> _donations     = Array.Empty<DonationListDto>();
    private IReadOnlyList<InteractionDto>  _interactions  = Array.Empty<InteractionDto>();
    private ContactEngagementDto?          _engagement;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var t1 = ContactsApi.GetContactAsync(Id);
        var t2 = DonationsApi.GetDonationsAsync(new PaginationParams { PageSize = 200 }, contactId: Id);
        var t3 = InteractionsApi.GetInteractionsAsync(Id);
        var t4 = EventsApi.GetContactEngagementAsync(Id);
        await Task.WhenAll(t1, t2, t3, t4);
        _contact      = t1.Result.Data;
        _donations    = t2.Result.Data?.Items ?? Array.Empty<DonationListDto>();
        _interactions = t3.Result.Data ?? Array.Empty<InteractionDto>();
        _engagement   = t4.Result.Data;
        _loading = false;
    }

    private void OnContactAnonymized()
    {
        if (_contact is null) Nav.NavigateTo("/contacts");
        else _ = LoadAsync();
    }

    private async Task OpenEditDialog()
    {
        var d = DialogService.Show<ContactFormDialog>("Redigera",
            new DialogParameters { ["ContactId"] = Id },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task OpenSendEmailDialog()
    {
        var d = DialogService.Show<SendEmailToContactDialog>("Skicka e-post",
            new DialogParameters
            {
                ["ContactName"]  = _contact?.FullName ?? string.Empty,
                ["ContactEmail"] = _contact?.Email,
                ["EmailOptOut"]  = _contact?.EmailOptOut ?? false
            },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        await d.Result;
    }

    private async Task OpenDonationDialog()
    {
        var d = DialogService.Show<DonationFormDialog>("Registrera gåva",
            new DialogParameters { ["PresetContactId"] = Id },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task OpenDonationSummaryDialog()
    {
        var d = DialogService.Show<GenerateDonationSummaryDialog>("Generera årsbesked",
            new DialogParameters { ["ContactId"] = Id, ["ContactName"] = _contact?.FullName ?? "" },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        await d.Result;
    }

    private async Task OpenLogInteractionDialog()
    {
        var d = DialogService.Show<LogInteractionDialog>("Logga interaktion",
            new DialogParameters { ["ContactId"] = Id },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task DeleteInteraction(Guid interactionId)
    {
        var p = new DialogParameters
        {
            ["Title"]   = "Ta bort interaktion",
            ["Message"] = "Är du säker?"
        };
        if ((await DialogService.Show<ConfirmDialog>("", p).Result).Canceled) return;
        var res = await InteractionsApi.DeleteInteractionAsync(interactionId);
        if (res.Success) { Snackbar.Add("Borttagen.", Severity.Success); await LoadAsync(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Fel.", Severity.Error);
    }

    private static Color SegmentColor(string segment) => segment switch
    {
        "Core"     => Color.Success,
        "Growing"  => Color.Info,
        "New"      => Color.Primary,
        "AtRisk"   => Color.Warning,
        "Lapsed"   => Color.Error,
        _          => Color.Default
    };
}
