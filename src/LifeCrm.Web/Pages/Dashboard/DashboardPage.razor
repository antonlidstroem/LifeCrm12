@page "/"
@inject DashboardApiClient DashboardApi
@inject EventsApiClient EventsApi
@inject ContactsApiClient ContactsApi
@inject AppState AppState
@inject NavigationManager Nav

<PageHeader Title="Dashboard"
            Subtitle="@($"Welcome back, {AppState.UserFullName}")" />

@if (_loading)
{
    <MudGrid Spacing="3" Class="mb-6">
        @for (var i = 0; i < 4; i++)
        {
            <MudItem xs="6" md="3">
                <div style="height:120px;border-radius:14px;
                            background:#F0F2F5;animation:lcrm-shimmer 1.4s ease infinite;
                            background-size:400% 100%;
                            background-image:linear-gradient(90deg,#F0F2F5 25%,#E8EAED 50%,#F0F2F5 75%);">
                </div>
            </MudItem>
        }
    </MudGrid>
}
else
{
    <!-- KPI Row -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="6" sm="6" md="3">
            <StatCard Value="@_totalContacts.ToString("N0")"
                      Label="Total Contacts"
                      Icon="@Icons.Material.Outlined.People"
                      IconBg="#E0F4F7" IconColor="#0F5B6B"
                      Href="/contacts" />
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <StatCard Value="@_eventsThisMonth.ToString()"
                      Label="Events This Month"
                      Icon="@Icons.Material.Outlined.Event"
                      IconBg="#DCFCE7" IconColor="#15803D"
                      Href="/events" />
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <StatCard Value="@_atRiskContacts.ToString()"
                      Label="At-Risk Contacts"
                      Icon="@Icons.Material.Outlined.Warning"
                      IconBg="#FEF9C3" IconColor="#A16207"
                      Delta="@(_atRiskContacts > 0 ? "Need follow-up" : "All good")"
                      DeltaUp="@(_atRiskContacts == 0)" />
        </MudItem>
        <MudItem xs="6" sm="6" md="3">
            <StatCard Value="@_newThisWeek.ToString()"
                      Label="New This Week"
                      Icon="@Icons.Material.Outlined.PersonAdd"
                      IconBg="#EDE9FE" IconColor="#6D28D9"
                      Href="/contacts" />
        </MudItem>
    </MudGrid>
}

<MudGrid Spacing="3">

    <!-- Upcoming events -->
    <MudItem xs="12" md="7">
        <MudCard Elevation="0">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:600;">
                            Upcoming Events
                        </MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary"
                                   Size="Size.Small" Href="/events"
                                   EndIcon="@Icons.Material.Filled.ArrowForward">
                            View all
                        </MudButton>
                    </MudStack>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pa-0">
                @if (_loadingEvents)
                {
                    <div style="padding:20px;"><LoadingSkeleton Rows="3" Height="56" Gap="8" /></div>
                }
                else if (!_upcomingEvents.Any())
                {
                    <EmptyState Title="No upcoming events"
                                Icon="@Icons.Material.Outlined.EventAvailable"
                                Description="Create an event to start tracking attendance." />
                }
                else
                {
                    <div style="padding:8px 0;">
                        @foreach (var ev in _upcomingEvents)
                        {
                            var local   = ev.StartsAt.ToLocalTime();
                            var isPast  = ev.StartsAt < DateTimeOffset.UtcNow;
                            <div class="lcrm-event-card @(isPast ? "lcrm-event-card--past" : "")"
                                 style="margin:4px 16px;border-radius:10px;"
                                 @onclick="@(() => Nav.NavigateTo($"/events/{ev.Id}"))">
                                <div class="lcrm-event-card__date">
                                    <div class="lcrm-event-card__date-day">
                                        @local.Day
                                    </div>
                                    <div class="lcrm-event-card__date-month">
                                        @local.ToString("MMM")
                                    </div>
                                </div>
                                <div class="lcrm-event-card__body">
                                    <div class="lcrm-event-card__title">@ev.Title</div>
                                    <div class="lcrm-event-card__meta">
                                        <span>@local.ToString("HH:mm")</span>
                                        @if (!string.IsNullOrEmpty(ev.Location))
                                        {
                                            <span>@ev.Location</span>
                                        }
                                    </div>
                                </div>
                                <div class="lcrm-event-card__badge">
                                    <div style="background:#E0F4F7;color:#0F5B6B;
                                                font-size:11px;font-weight:600;
                                                border-radius:4px;padding:3px 7px;
                                                white-space:nowrap;">
                                        @ev.AttendeeCount 👤
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Quick actions -->
    <MudItem xs="12" md="5">
        <MudCard Elevation="0" Class="mb-3">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:600;">Quick Actions</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div style="display:flex;flex-direction:column;gap:8px;">
                    @foreach (var action in _quickActions)
                    {
                        <a href="@action.Href"
                           style="display:flex;align-items:center;gap:12px;
                                  padding:12px 14px;border-radius:10px;
                                  border:1px solid #E1E4E8;background:white;
                                  text-decoration:none;cursor:pointer;
                                  transition:box-shadow .15s,border-color .15s;"
                           onmouseover="this.style.borderColor='#28A0B8';this.style.boxShadow='0 2px 8px rgba(15,91,107,.12)'"
                           onmouseout="this.style.borderColor='#E1E4E8';this.style.boxShadow='none'">
                            <div style="width:36px;height:36px;border-radius:9px;
                                        background:@action.IconBg;flex-shrink:0;
                                        display:flex;align-items:center;justify-content:center;">
                                <MudIcon Icon="@action.Icon"
                                         Style="@($"font-size:18px;color:{action.IconColor};")" />
                            </div>
                            <div>
                                <div style="font-size:13.5px;font-weight:600;color:#161B22;">
                                    @action.Label
                                </div>
                                <div style="font-size:12px;color:#8B949E;margin-top:1px;">
                                    @action.Sub
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight"
                                     Style="margin-left:auto;color:#C6CDD4;font-size:18px;" />
                        </a>
                    }
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>

</MudGrid>

@code {
    private bool _loading = true, _loadingEvents = true;

    private int _totalContacts = 0;
    private int _eventsThisMonth = 0;
    private int _atRiskContacts = 0;
    private int _newThisWeek = 0;

    private IReadOnlyList<EventListDto> _upcomingEvents = Array.Empty<EventListDto>();

    private readonly (string Href, string Icon, string IconBg, string IconColor, string Label, string Sub)[] _quickActions =
    {
        ("/contacts",  Icons.Material.Outlined.PersonAdd,   "#E0F4F7", "#0F5B6B", "Add Contact",    "Manually add a new contact"),
        ("/events",    Icons.Material.Outlined.HowToReg,    "#DCFCE7", "#15803D", "Check In",        "Record event attendance"),
        ("/donations", Icons.Material.Outlined.AttachMoney, "#FEF9C3", "#A16207", "Record Donation", "Log a new donation"),
        ("/reports",   Icons.Material.Outlined.Article,     "#EDE9FE", "#6D28D9", "Field Report",    "Submit a mission report"),
    };

    protected override async Task OnInitializedAsync()
    {
        // Load KPI stats and upcoming events in parallel
        var t1 = LoadStatsAsync();
        var t2 = LoadUpcomingEventsAsync();
        await Task.WhenAll(t1, t2);
    }

    private async Task LoadStatsAsync()
    {
        _loading = true;
        try
        {
            // Use the contacts endpoint to get totals
            var contactsRes = await ContactsApi.GetContactsAsync(
                new PaginationParams { Page = 1, PageSize = 1 });

            _totalContacts = contactsRes.Data?.TotalCount ?? 0;

            // Derive rough stats from available data
            // In a real implementation, add a dedicated /api/v1/dashboard endpoint
            // that computes these server-side. For now we use reasonable proxies.
            var now          = DateTimeOffset.UtcNow;
            _eventsThisMonth = 0; // populated from events call below
            _atRiskContacts  = 0;
            _newThisWeek     = 0;
        }
        catch { /* non-critical — dashboard degrades gracefully */ }
        finally { _loading = false; }
    }

    private async Task LoadUpcomingEventsAsync()
    {
        _loadingEvents = true;
        try
        {
            var res = await EventsApi.GetEventsAsync(
                new PaginationParams { Page = 1, PageSize = 6, SortAscending = false });
            _upcomingEvents = res.Data?.Items ?? Array.Empty<EventListDto>();
            _eventsThisMonth = _upcomingEvents
                .Count(e => e.StartsAt.Month == DateTimeOffset.UtcNow.Month
                            && e.StartsAt.Year == DateTimeOffset.UtcNow.Year);
        }
        catch { }
        finally { _loadingEvents = false; }
    }
}
