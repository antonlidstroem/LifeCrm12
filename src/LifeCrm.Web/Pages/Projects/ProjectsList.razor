@* src/LifeCrm.Web/Pages/Projects/ProjectsList.razor *@
@page "/projects"
@using LifeCrm.Web.Services
@using LifeCrm.Web.Shared
@using LifeCrm.Contracts.Common.DTOs
@using LifeCrm.Contracts.Projects.DTOs
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Projects — LifeCrm</PageTitle>

<div class="lc-page-enter">
    <PageHeader Title="Projects"
                Subtitle="@(_totalCount > 0 ? $"{_totalCount:N0} projects" : null)">
        <Actions>
            @if (AppState.CanWrite)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.CreateNewFolder"
                           Href="/projects/new">
                    New Project
                </MudButton>
            }
        </Actions>
    </PageHeader>

    <!-- Search -->
    <div class="lc-filter-bar">
        <div class="lc-search" style="min-width:280px;">
            <MudIcon Icon="@Icons.Material.Outlined.Search"
                     Size="Size.Small" Class="lc-search__icon" />
            <input class="lc-search__input" placeholder="Search projects or location…"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
        </div>
    </div>

    <!-- Desktop: grid of project cards -->
    <div class="lc-hide-mobile">
        @if (_loading)
        {
            <div class="lc-project-grid">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="lc-skeleton-row" style="height:160px;border-radius:6px;"></div>
                }
            </div>
        }
        else if (!_projects.Any())
        {
            <DataCard>
                <div class="lc-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.AccountTree"
                             Style="font-size:40px;color:var(--lc-text-disabled)" />
                    <span class="lc-empty__title">No projects yet</span>
                    <span class="lc-empty__subtitle">Create your first project to organise campaigns and donations.</span>
                </div>
            </DataCard>
        }
        else
        {
            <div class="lc-project-grid">
                @foreach (var p in _projects)
                {
                    <div class="lc-project-card" @onclick="() => GoTo(p)">
                        <div class="lc-project-card__header">
                            <div>
                                <h3 class="lc-project-card__title">@p.Name</h3>
                                @if (!string.IsNullOrEmpty(p.Location))
                                {
                                    <div class="lc-project-card__location">
                                        <MudIcon Icon="@Icons.Material.Outlined.LocationOn"
                                                 Size="Size.Small" />
                                        @p.Location
                                    </div>
                                }
                            </div>
                            <StatusBadge Text="@p.Status.ToString()"
                                         Variant="@StatusBadge.VariantFromProjectStatus(p.Status)" />
                        </div>

                        @if (p.BudgetGoal.HasValue && p.BudgetGoal > 0)
                        {
                            var pct = Math.Min((double)(p.TotalFunded / p.BudgetGoal.Value * 100), 100);
                            <div class="lc-project-card__progress">
                                <div class="lc-project-card__progress-row">
                                    <span class="lc-mono" style="font-size:16px;font-weight:500;color:var(--lc-text-primary);">
                                        $@p.TotalFunded.ToString("N0")
                                    </span>
                                    <span class="lc-muted" style="font-size:12px;">
                                        of $@p.BudgetGoal.Value.ToString("N0")
                                    </span>
                                </div>
                                <div class="lc-progress-bar">
                                    <div class="lc-progress-bar__fill @(pct >= 100 ? "lc-progress-bar__fill--success" : "")"
                                         style="width:@pct.ToString("F1")%"></div>
                                </div>
                                <span class="lc-muted" style="font-size:11px;">@pct.ToString("N1")% funded</span>
                            </div>
                        }
                        else
                        {
                            <div class="lc-project-card__funded">
                                <span class="lc-mono" style="font-size:16px;font-weight:500;">
                                    $@p.TotalFunded.ToString("N0")
                                </span>
                                <span class="lc-muted" style="font-size:12px;">raised</span>
                            </div>
                        }

                        <div class="lc-project-card__footer">
                            @if (p.StartDate.HasValue)
                            {
                                <span class="lc-col-date" style="font-size:11px;">
                                    @p.StartDate.Value.ToString("yyyy-MM-dd")
                                    @(p.EndDate.HasValue ? $" → {p.EndDate.Value:yyyy-MM-dd}" : "")
                                </span>
                            }
                            <MudIcon Icon="@Icons.Material.Outlined.ChevronRight"
                                     Size="Size.Small" Style="color:var(--lc-text-disabled);margin-left:auto;" />
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Mobile card list -->
    <div class="lc-show-mobile lc-card-list">
        @if (_loading)
        {
            @for (int i = 0; i < 4; i++)
            {
                <div class="lc-skeleton-row" style="height:100px;"></div>
            }
        }
        else
        {
            @foreach (var p in _projects)
            {
                <div class="lc-list-card" @onclick="() => GoTo(p)">
                    <div class="lc-list-card__header">
                        <span class="lc-list-card__title">@p.Name</span>
                        <StatusBadge Text="@p.Status.ToString()"
                                     Variant="@StatusBadge.VariantFromProjectStatus(p.Status)" />
                    </div>
                    <div class="lc-list-card__meta">
                        <span class="lc-mono">$@p.TotalFunded.ToString("N0") raised</span>
                        @if (!string.IsNullOrEmpty(p.Location))
                        {
                            <span class="lc-muted">@p.Location</span>
                        }
                    </div>
                    @if (p.BudgetGoal.HasValue && p.BudgetGoal > 0)
                    {
                        var pct = Math.Min((double)(p.TotalFunded / p.BudgetGoal.Value * 100), 100);
                        <div class="lc-progress-bar" style="margin-top:4px;">
                            <div class="lc-progress-bar__fill" style="width:@pct.ToString("F1")%"></div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="lc-table-footer" style="margin-top:16px;">
        <span class="lc-muted" style="font-size:12px;">@_projects.Count of @_totalCount</span>
        <MudPagination Count="_totalPages" Selected="_page"
                       SelectedChanged="OnPageChanged"
                       Color="Color.Primary" Size="Size.Small" />
    </div>
</div>

<style>
    .lc-project-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 16px;
    }

    .lc-project-card {
        background: var(--lc-surface);
        border: 1px solid var(--lc-border);
        border-radius: var(--lc-radius);
        padding: 18px;
        display: flex; flex-direction: column; gap: 12px;
        cursor: pointer;
        transition: border-color var(--lc-transition), transform var(--lc-transition);
    }
    .lc-project-card:hover {
        border-color: var(--lc-border-light);
        transform: translateY(-1px);
    }

    .lc-project-card__header {
        display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
    }

    .lc-project-card__title {
        margin: 0; font-size: 14px; font-weight: 600;
        color: var(--lc-text-primary); line-height: 1.4;
    }

    .lc-project-card__location {
        display: flex; align-items: center; gap: 3px;
        font-size: 11px; color: var(--lc-text-secondary);
        margin-top: 3px;
    }

    .lc-project-card__progress { display: flex; flex-direction: column; gap: 4px; }
    .lc-project-card__progress-row {
        display: flex; justify-content: space-between; align-items: baseline;
    }

    .lc-project-card__funded {
        display: flex; align-items: baseline; gap: 6px;
    }

    .lc-project-card__footer {
        display: flex; align-items: center;
        margin-top: auto; padding-top: 4px;
        border-top: 1px solid var(--lc-border);
    }

    .lc-filter-bar {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 16px; flex-wrap: wrap;
    }

    @media (max-width: 1100px) { .lc-project-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 640px)  { .lc-project-grid { grid-template-columns: 1fr; } }
</style>

@code {
    private List<ProjectListDto> _projects = new();
    private bool    _loading    = true;
    private string? _search;
    private int     _page       = 1;
    private int     _totalCount = 0;
    private int     _totalPages = 1;
    private const int PageSize  = 12;

    private System.Timers.Timer? _debounce;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var resp = await Api.GetProjectsAsync(new PaginationParams
            { Page = _page, PageSize = PageSize, Search = _search });
        if (resp.Success && resp.Data is not null)
        {
            _projects   = resp.Data.Items.ToList();
            _totalCount = resp.Data.TotalCount;
            _totalPages = resp.Data.TotalPages;
        }
        _loading = false;
    }

    private void OnSearchKey(KeyboardEventArgs _)
    {
        _debounce?.Dispose();
        _debounce = new System.Timers.Timer(350);
        _debounce.Elapsed += async (_, _) =>
        {
            _debounce?.Dispose();
            _page = 1;
            await InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });
        };
        _debounce.AutoReset = false;
        _debounce.Start();
    }

    private async Task OnPageChanged(int p) { _page = p; await LoadAsync(); }
    private void GoTo(ProjectListDto p) => Nav.NavigateTo($"/projects/{p.Id}");
}
