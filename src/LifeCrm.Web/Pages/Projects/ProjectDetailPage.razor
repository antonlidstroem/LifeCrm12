@page "/projects/{Id:guid}"
@inject ProjectsApiClient ProjectsApi
@inject DonationsApiClient DonationsApi
@inject InteractionsApiClient InteractionsApi
@inject ReportsApiClient ReportsApi
@inject AppState AppState
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/projects"))" />
    <MudText Typo="Typo.h5">@(_project?.Name ?? "Laddar…")</MudText>
    <MudSpacer />
    @if (AppState.CanWrite && _project is not null)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditDialog">
            Redigera
        </MudButton>
    }
</MudStack>

@if (_loading) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" /> }
else if (_project is not null)
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudCard Elevation="2">
                <MudCardContent>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@_project.Status.ToMudColor()" Class="mb-3">@_project.Status</MudChip>
                    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-3">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Finansierat</MudText>
                            <MudText Typo="Typo.h6">$@_project.TotalFunded.ToString("N2")</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Mål</MudText>
                            <MudText Typo="Typo.h6">@(_project.BudgetGoal.HasValue ? $"${_project.BudgetGoal:N2}" : "—")</MudText>
                        </div>
                    </MudStack>
                    @if (!string.IsNullOrEmpty(_project.Location))
                    {
                        <MudList T="string" Dense="true">
                            <MudListItem Icon="@Icons.Material.Filled.LocationOn">@_project.Location</MudListItem>
                        </MudList>
                    }
                    @if (!string.IsNullOrEmpty(_project.Description))
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Beskrivning</MudText>
                        <MudText Typo="Typo.body2" Class="mt-1">@_project.Description</MudText>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">

                <!-- Donations -->
                <MudTabPanel Text="Gåvor" Icon="@Icons.Material.Filled.AttachMoney">
                    @if (!_donations.Any())
                    {
                        <EmptyState Title="Inga gåvor kopplade" Icon="@Icons.Material.Outlined.AttachMoney" />
                    }
                    else
                    {
                        <MudTable T="DonationListDto" Items="_donations" Dense="true" Hover="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Datum</MudTh><MudTh>Givare</MudTh><MudTh>Belopp</MudTh><MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd><MudLink Href="@($"/contacts/{context.ContactId}")">@context.ContactName</MudLink></MudTd>
                                <MudTd>$@context.Amount.ToString("N2")</MudTd>
                                <MudTd>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                             Color="@context.Status.ToMudColor()">@context.Status</MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudTabPanel>

                <!-- Interactions -->
                <MudTabPanel Text="Interaktioner" Icon="@Icons.Material.Filled.Chat">
                    @if (AppState.CanWrite)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                   Class="mb-4" OnClick="OpenLogInteractionDialog">Logga interaktion</MudButton>
                    }
                    @if (!_interactions.Any())
                    {
                        <EmptyState Title="Inga interaktioner" Icon="@Icons.Material.Outlined.Chat" />
                    }
                    else
                    {
                        <MudTimeline TimelinePosition="TimelinePosition.Start">
                            @foreach (var i in _interactions.OrderByDescending(x => x.OccurredAt))
                            {
                                <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                                    <ItemContent>
                                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-1">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary">@i.Type</MudChip>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@i.OccurredAt.ToString("g")</MudText>
                                        </MudStack>
                                        <MudText Typo="Typo.body2">@i.Body</MudText>
                                    </ItemContent>
                                </MudTimelineItem>
                            }
                        </MudTimeline>
                    }
                </MudTabPanel>

                <!-- Field Reports — FIX: show refresh button + proper empty state -->
                <MudTabPanel Text="@($"Field Reports ({_reports.Count})")" Icon="@Icons.Material.Filled.Article">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                        @if (AppState.CanWrite)
                        {
                            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                                       OnClick="NewReport">New field report</MudButton>
                        }
                        <MudSpacer />
                        <MudTooltip Text="Refresh reports">
                            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small"
                                           OnClick="RefreshReports" />
                        </MudTooltip>
                    </MudStack>

                    @if (_reportsLoading)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                    }
                    else if (!_reports.Any())
                    {
                        <EmptyState Title="No field reports for this project" Icon="@Icons.Material.Outlined.Article"
                                    Description="Create a new field report linked to this project." />
                    }
                    else
                    {
                        @foreach (var r in _reports)
                        {
                            <MudPaper Elevation="0" Class="pa-3 mb-2 cursor-pointer"
                                      Style="border:1px solid var(--mud-palette-divider);border-radius:6px"
                                      @onclick="@(() => Nav.NavigateTo($"/reports/{r.Id}"))">
                                <MudStack Row="true" AlignItems="AlignItems.Center">
                                    <div style="flex:1">
                                        <MudText Typo="Typo.body2"><b>@r.Title</b></MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @r.ReportDate.ToString("yyyy-MM-dd") · @r.AuthorName
                                        </MudText>
                                    </div>
                                    @if (r.DecisionTotal > 0)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                            @r.DecisionTotal decisions
                                        </MudChip>
                                    }
                                    <ReportStatusChip Status="@r.Status" />
                                </MudStack>
                            </MudPaper>
                        }
                    }
                </MudTabPanel>
            </MudTabs>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ProjectDto? _project;
    private IReadOnlyList<DonationListDto> _donations    = Array.Empty<DonationListDto>();
    private IReadOnlyList<InteractionDto>  _interactions = Array.Empty<InteractionDto>();
    private List<MissionReportListDto>     _reports      = new();
    private bool _loading = true, _reportsLoading = false;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // FIX: reload when navigating back to the same page with a different Id
    protected override async Task OnParametersSetAsync()
    {
        if (!_loading) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var t1 = ProjectsApi.GetProjectAsync(Id);
        var t2 = DonationsApi.GetDonationsAsync(new PaginationParams { PageSize = 200 }, projectId: Id);
        var t3 = InteractionsApi.GetProjectInteractionsAsync(Id);
        var t4 = ReportsApi.GetReportsAsync(new PaginationParams { PageSize = 100 }, projectId: Id);
        await Task.WhenAll(t1, t2, t3, t4);
        _project      = t1.Result.Data;
        _donations    = t2.Result.Data?.Items ?? Array.Empty<DonationListDto>();
        _interactions = t3.Result.Data ?? Array.Empty<InteractionDto>();
        _reports      = t4.Result.Data?.Items.ToList() ?? new();
        _loading      = false;
    }

    private async Task RefreshReports()
    {
        _reportsLoading = true;
        var res = await ReportsApi.GetReportsAsync(new PaginationParams { PageSize = 100 }, projectId: Id);
        _reports = res.Data?.Items.ToList() ?? new();
        _reportsLoading = false;
    }

    // FIX: navigate to /reports/new?projectId=… which creates server-side then redirects
    private void NewReport() => Nav.NavigateTo($"/reports/new?projectId={Id}");

    private async Task OpenEditDialog()
    {
        var d = DialogService.Show<ProjectFormDialog>("Redigera",
            new DialogParameters { ["ProjectId"] = Id },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await d.Result).Canceled) await LoadAsync();
    }

    private async Task OpenLogInteractionDialog()
    {
        var d = DialogService.Show<LogInteractionDialog>("Logga interaktion",
            new DialogParameters { ["ProjectId"] = Id },
            new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true });
        if (!(await d.Result).Canceled) await LoadAsync();
    }
}
