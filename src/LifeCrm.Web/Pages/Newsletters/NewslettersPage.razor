@page "/newsletters"
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Nyhetsbrev</MudText>
    <MudSpacer />
    @if (AppState.CanWrite)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EditNote"
                   OnClick="CreateDraft">Nytt nyhetsbrev</MudButton>
    }
</MudStack>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Spacing="2">
    <MudChipSet T="string" SelectedValue="_statusFilter" SelectedValueChanged="OnStatusFilterChanged"
                SelectionMode="SelectionMode.SingleSelection">
        <MudChip T="string" Value="@("")"      Variant="Variant.Outlined">Alla</MudChip>
        <MudChip T="string" Value="@("Draft")" Variant="Variant.Outlined">Utkast</MudChip>
        <MudChip T="string" Value="@("Sent")"  Variant="Variant.Outlined">Skickade</MudChip>
    </MudChipSet>
</MudStack>

<MudTable T="NewsletterListDto" ServerData="ServerReload" @ref="_table" Hover="true" Dense="true"
          OnRowClick="@((TableRowClickEventArgs<NewsletterListDto> e) => OpenDetail(e.Item))">
    <HeaderContent>
        <MudTh>Titel</MudTh><MudTh>Status</MudTh><MudTh>Skapad</MudTh>
        <MudTh>Skickat</MudTh><MudTh>Mottagare</MudTh><MudTh Style="width:90px"></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>
            <MudText Typo="Typo.body2"><b>@context.Title</b></MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Subject</MudText>
        </MudTd>
        <MudTd>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                     Color="@(context.Status == NewsletterStatus.Sent ? Color.Success : Color.Default)">
                @(context.Status == NewsletterStatus.Sent ? "Skickat" : "Utkast")
            </MudChip>
        </MudTd>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@(context.SentAt.HasValue ? context.SentAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "—")</MudTd>
        <MudTd>
            @if (context.Status == NewsletterStatus.Sent) { <MudText Typo="Typo.body2">@context.SentCount</MudText> }
            else { <MudText Color="Color.Secondary">—</MudText> }
        </MudTd>
        <MudTd @onclick:stopPropagation="true" Style="white-space:nowrap">
            @if (context.Status == NewsletterStatus.Draft && AppState.CanWrite)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => Nav.NavigateTo($"/newsletters/{context.Id}/edit"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteDraft(context))" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent>
        <EmptyState Title="Inga nyhetsbrev ännu" Icon="@Icons.Material.Outlined.MarkEmailRead">
            <ActionContent>
                @if (AppState.CanWrite)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateDraft">
                        Skapa nyhetsbrev
                    </MudButton>
                }
            </ActionContent>
        </EmptyState>
    </NoRecordsContent>
    <LoadingContent><LoadingSkeleton Rows="5" /></LoadingContent>
    <PagerContent><MudTablePager PageSizeOptions="new int[]{25,50}" /></PagerContent>
</MudTable>

@code {
    private MudTable<NewsletterListDto>? _table;
    private string _statusFilter = "";

    private async Task OnStatusFilterChanged(string value)
    {
        _statusFilter = value;
        if (_table is not null) await _table.ReloadServerData();
    }

    private async Task<TableData<NewsletterListDto>> ServerReload(TableState state, CancellationToken ct)
    {
        NewsletterStatus? statusEnum = _statusFilter switch
        {
            "Draft" => NewsletterStatus.Draft,
            "Sent"  => NewsletterStatus.Sent,
            _       => null
        };
        var res = await Api.GetNewslettersAsync(new PaginationParams { Page = state.Page + 1, PageSize = state.PageSize }, statusEnum);
        return new TableData<NewsletterListDto>
        {
            Items      = res.Data?.Items ?? Array.Empty<NewsletterListDto>(),
            TotalItems = res.Data?.TotalCount ?? 0
        };
    }

    private async Task CreateDraft()
    {
        // FIX: Supply a non-empty Subject and HtmlBody — the API has [Required] on Subject
        // and the validator rejects empty strings. Use placeholder content so the draft saves.
        var today = DateTime.Today.ToString("yyyy-MM-dd");
        var req = new CreateNewsletterRequest
        {
            Title   = $"Nyhetsbrev {today}",
            Subject = $"Nyhetsbrev {today}",          // required — user edits in compose
            HtmlBody = "<p>Skriv ert nyhetsbrev här.</p>"  // required — user replaces
        };
        var res = await Api.CreateNewsletterAsync(req);
        if (res.Success && res.Data != default)
        {
            Nav.NavigateTo($"/newsletters/{res.Data}/edit");
        }
        else
        {
            Snackbar.Add(res.Errors.FirstOrDefault() ?? "Kunde inte skapa utkast.", Severity.Error);
        }
    }

    private void OpenDetail(NewsletterListDto nl)
        => Nav.NavigateTo(nl.Status == NewsletterStatus.Draft
            ? $"/newsletters/{nl.Id}/edit"
            : $"/newsletters/{nl.Id}");

    private async Task DeleteDraft(NewsletterListDto nl)
    {
        var p = new DialogParameters
        {
            ["Title"]   = "Ta bort utkast",
            ["Message"] = $"Ta bort '{nl.Title}'?"
        };
        var confirm = DialogService.Show<ConfirmDialog>("", p);
        if ((await confirm.Result).Canceled) return;
        var res = await Api.DeleteNewsletterAsync(nl.Id);
        if (res.Success) { Snackbar.Add("Utkastet har tagits bort.", Severity.Success); if (_table is not null) await _table.ReloadServerData(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Fel.", Severity.Error);
    }
}
