@page "/newsletters/{Id:guid}/edit"
@using System.Timers
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject NewslettersApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/newsletters"))" />
        <MudText Typo="Typo.h5">@(_isDirty ? "✎ " : "")@_title</MudText><MudSpacer />
        @if (_saving)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-3">Sparar…</MudText>
        }
        else if (_lastSaved.HasValue)
        {

            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-3">Sparad @_lastSaved.Value.ToString("HH:mm:ss")</MudText>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send" OnClick="OpenSendPanel" Disabled="@(string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_htmlBody))">Gå till sändning</MudButton>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="8">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudGrid Spacing="2">
                        <MudItem xs="12"><MudTextField @bind-Value="_title" Label="Intern titel" Variant="Variant.Outlined" Immediate="true" TextChanged="OnFieldChanged" /></MudItem>
                        <MudItem xs="12"><MudTextField @bind-Value="_subject" Label="Ämnesrad *" Variant="Variant.Outlined" Immediate="true" TextChanged="OnFieldChanged" /></MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2" Class="mb-3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1">Innehåll *</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_htmlBody" Variant="Variant.Outlined" Lines="15" Placeholder="<p>Hej!</p>" Immediate="true" TextChanged="OnFieldChanged" Style="font-family:monospace;font-size:13px" />
                </MudCardContent>
            </MudCard>

            <MudCard Elevation="2">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1">Bilagor</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent>
                    @* FIX: Använder ActivatorContent för MudBlazor v7+ *@
                    <MudFileUpload T="IBrowserFile" OnFilesChanged="UploadFile" Accept=".pdf,.jpg,.png,.docx">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                Ladda upp bilaga
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>

                    <MudList T="AttachmentDto" Class="mt-2">
                        @foreach (var att in _attachments)
                        {
                            <MudListItem Icon="@Icons.Material.Filled.AttachFile">
                                <div class="d-flex align-center">
                                    @* Säkerställ att egenskapen heter FileSizeBytes i din DTO, annars ändra till FileSize *@
                                    <MudText Typo="Typo.body2">@att.FileName (@(att.FileSizeBytes / 1024) KB)</MudText>
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteAttachment(att))" />
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1">Förhandsgranskning</MudText></CardHeaderContent></MudCardHeader>
                <MudCardContent Style="max-height:500px;overflow-y:auto;background:white;color:black;">
                    @if (!string.IsNullOrWhiteSpace(_subject))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Ämne: @_subject</MudText>
                        <MudDivider Class="my-2" />
     }
                    @if (!string.IsNullOrWhiteSpace(_htmlBody))
                    {
                        <div>@((MarkupString)_htmlBody)</div>
                    }
                </MudCardContent>
            </MudCard>

            @if (_sendPanelOpen)
            {
                <MudCard Elevation="4" Style="border:2px solid var(--mud-palette-primary)">
                    <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle1" Color="Color.Primary">Mottagare</MudText></CardHeaderContent></MudCardHeader>
                    <MudCardContent>
                        <MudStack Spacing="3">
                            <MudTextField @bind-Value="_tagFilter" Label="Tagg-filter" Variant="Variant.Outlined" TextChanged="@(_ => LoadPreview())" />
                            <MudSelect T="string" Label="Kontakttyp" Variant="Variant.Outlined" @bind-Value="_contactTypeFilter" SelectedValuesChanged="@(_ => LoadPreview())">
                                <MudSelectItem Value="@("")">Alla</MudSelectItem>
                                <MudSelectItem Value="@("Customer")">Kunder</MudSelectItem>
                                <MudSelectItem Value="@("Lead")">Prospekts</MudSelectItem>
                            </MudSelect>
                        </MudStack>
                        @if (_preview is not null)
                        {
                            <MudAlert Severity="Severity.Info" Class="mt-4">@_preview.EligibleCount mottagare hittades.</MudAlert>
                        }
                    </MudCardContent>
                    <MudCardActions Class="px-4 pb-4 flex-column">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="ConfirmSend" Disabled="@(_sending || _preview?.EligibleCount == 0)">
                            @if (_sending)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                            }
                            else
                            {

                                <span>Skicka nu</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Text" FullWidth="true" OnClick="CloseSendPanel">Avbryt</MudButton>
                    </MudCardActions>
                </MudCard>
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private string _title = "", _subject = "", _htmlBody = "", _tagFilter = "", _contactTypeFilter = "";
    private bool _loading = true, _saving, _isDirty, _sendPanelOpen, _sending, _previewing;
    private List<AttachmentDto> _attachments = new();
    private NewsletterPreviewDto? _preview;
    private NewsletterSendResultDto? _sendResult;
    private DateTime? _lastSaved;
    private Timer? _saveTimer;

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetNewsletterAsync(Id);
        if (res.Data is null) { Nav.NavigateTo("/newsletters"); return; }
        _title = res.Data.Title; _subject = res.Data.Subject; _htmlBody = res.Data.HtmlBody;
        _attachments = res.Data.Attachments?.ToList() ?? new();
        _loading = false;
        _saveTimer = new Timer(2000) { AutoReset = false };
        _saveTimer.Elapsed += async (_, _) => await InvokeAsync(AutoSave);
    }

    private void OnFieldChanged(string _) { _isDirty = true; _saveTimer?.Stop(); _saveTimer?.Start(); }

    private async Task AutoSave()
    {
        if (!_isDirty || _saving) return;
        _saving = true; StateHasChanged();
        await Api.UpdateNewsletterAsync(Id, new UpdateNewsletterRequest { Id = Id, Title = _title, Subject = _subject, HtmlBody = _htmlBody });
        _saving = false; _isDirty = false; _lastSaved = DateTime.Now; StateHasChanged();
    }

    private async Task UploadFile(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(1))
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            var res = await Api.UploadNewsletterAttachmentAsync(Id, stream, file.Name, file.ContentType);
            if (res.Success && res.Data != null) _attachments.Add(res.Data);
        }
    }

    private async Task DeleteAttachment(AttachmentDto att)
    {
        if ((await Api.DeleteNewsletterAttachmentAsync(Id, att.Id)).Success) _attachments.Remove(att);
    }

    private async Task OpenSendPanel() { if (_isDirty) await AutoSave(); _sendPanelOpen = true; await LoadPreview(); }
    private void CloseSendPanel() { _sendPanelOpen = false; }

    private async Task LoadPreview()
    {
        var res = await Api.PreviewNewsletterRecipientsAsync(_tagFilter, _contactTypeFilter);
        _preview = res.Data; StateHasChanged();
    }

    private async Task ConfirmSend()
    {
        _sending = true;
        var res = await Api.SendNewsletterAsync(Id, new SendNewsletterRequest { TagFilter = _tagFilter, ContactTypeFilter = _contactTypeFilter });
        if (res.Success) Nav.NavigateTo($"/newsletters/{Id}");
        _sending = false;
    }

    public void Dispose() { _saveTimer?.Dispose(); }
}