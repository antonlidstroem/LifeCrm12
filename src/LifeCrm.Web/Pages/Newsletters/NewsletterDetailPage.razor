@page "/newsletters/{Id:guid}"
@inject NewslettersApiClient Api
@inject NavigationManager Nav

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_newsletter is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/newsletters"))" />
        <MudText Typo="Typo.h5">@_newsletter.Title</MudText><MudSpacer />
        <MudChip T="string" Color="Color.Success" Variant="Variant.Text">Skickat</MudChip>
    </MudStack>

    <MudGrid Spacing="3">
        <MudItem xs="12" md="3">
            <MudCard Elevation="2" Class="mb-3">
                <MudCardContent>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Statistik</MudText>
                    <MudText Typo="Typo.body2">Mottagare: <b>@_newsletter.SentCount</b></MudText>
                    <MudText Typo="Typo.body2">Datum: @_newsletter.SentAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</MudText>
                </MudCardContent>
            </MudCard>

            @if (_newsletter.Attachments?.Any() == true)
            {
                <MudCard Elevation="2">
                    <MudCardHeader><CardHeaderContent><MudText Typo="Typo.subtitle2">Bilagor</MudText></CardHeaderContent></MudCardHeader>
                    <MudCardContent Class="pa-0">
                        <MudList T="AttachmentDto">
                            @foreach (var att in _newsletter.Attachments)
                            {
                                <MudListItem Icon="@Icons.Material.Filled.FileDownload" OnClick="@(() => Api.DownloadNewsletterAttachmentAsync(Id, att.Id, att.FileName))">
                                    <MudText Typo="Typo.caption">@att.FileName</MudText>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                </MudCard>
            }
        </MudItem>

        <MudItem xs="12" md="9">
            <MudCard Elevation="2">
                <MudCardContent Style="background:white; color:black; min-height:400px;">
                    <MudText Typo="Typo.h6">@_newsletter.Subject</MudText>
                    <MudDivider Class="my-3" />
                    <div>@((MarkupString)_newsletter.HtmlBody)</div>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private NewsletterDetailDto? _newsletter;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetNewsletterAsync(Id);
        _newsletter = res.Data;
        _loading = false;
    }
}