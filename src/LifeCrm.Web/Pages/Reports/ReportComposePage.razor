@page "/reports/{Id:guid}/edit"
@using System.Timers
@implements IDisposable
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    <MudButton Class="mt-2" OnClick="@(() => Nav.NavigateTo("/reports"))">Back to Reports</MudButton>
}
else if (_report is not null)
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="@(() => Nav.NavigateTo("/reports"))" />
        <div>
            <MudText Typo="Typo.h5">@(_isDirty ? "✎ " : "")@_title</MudText>
            <ReportStatusChip Status="@_report.Status" />
        </div>
        <MudSpacer />
        @if (_saving) { <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-3">Saving…</MudText> }
        else if (_lastSaved.HasValue) { <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-3">Saved @_lastSaved.Value.ToString("HH:mm:ss")</MudText> }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Save" OnClick="ManualSave"
                   Disabled="_saving" Class="mr-2">Save</MudButton>
        @if (_report.Status is ReportStatus.Draft or ReportStatus.ReturnedForRevision)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Send"
                       OnClick="SubmitReport" Disabled="@(string.IsNullOrWhiteSpace(_title) || _saving)">
                Submit for approval
            </MudButton>
        }
    </MudStack>

    @if (_report.Status == ReportStatus.ReturnedForRevision && !string.IsNullOrEmpty(_report.ReviewComment))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            <b>Returned for revision:</b> @_report.ReviewComment
        </MudAlert>
    }

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4" @bind-ActivePanelIndex="_activeTab">

        <!-- ── Narrative ──────────────────────────────────────────────── -->
        <MudTabPanel Text="Narrative" Icon="@Icons.Material.Filled.Article">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="8">
                    <MudCard Elevation="0" Outlined="true" Class="mb-3">
                        <MudCardContent>
                            <MudGrid Spacing="2">
                                <MudItem xs="12">
                                    <MudTextField @bind-Value="_title" Label="Report title *" Variant="Variant.Outlined"
                                                  Immediate="true" @bind-Value:after="MarkDirty" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudDatePicker @bind-Date="_reportDate"
                                                   Label="Report date *"
                                                   Variant="Variant.Outlined"
                                                   Editable="true"
                                                   @bind-Date:after="MarkDirty" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudTextField @bind-Value="_location" Label="Location" Variant="Variant.Outlined"
                                                  Immediate="true" @bind-Value:after="MarkDirty" />
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudSelect T="ReportLanguage" @bind-Value="_language"
                                               Label="Language"
                                               Variant="Variant.Outlined"
                                               @bind-Value:after="MarkDirty">
                                        <MudSelectItem Value="ReportLanguage.English">English</MudSelectItem>
                                        <MudSelectItem Value="ReportLanguage.Swedish">Swedish</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>

                    <MudCard Elevation="0" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.subtitle1">Field Narrative</MudText></CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudTextField @bind-Value="_htmlBody" Variant="Variant.Outlined" Lines="14"
                                          Placeholder="Describe what happened in the field. HTML is supported."
                                          Immediate="true" @bind-Value:after="MarkDirty"
                                          Style="font-family:monospace;font-size:13px" />
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudCard Elevation="0" Outlined="true" Class="mb-3">
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Author: @_report.AuthorName</MudText>
                            @if (_report.CampaignName is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    Campaign: @_report.CampaignName
                                </MudText>
                            }
                            @if (_report.ProjectName is not null)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                    Project: @_report.ProjectName
                                </MudText>
                            }
                        </MudCardContent>
                    </MudCard>
                    @if (!string.IsNullOrWhiteSpace(_htmlBody))
                    {
                        <MudCard Elevation="0" Outlined="true">
                            <MudCardHeader>
                                <CardHeaderContent><MudText Typo="Typo.subtitle2">Preview</MudText></CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Style="max-height:360px;overflow-y:auto">
                                <div style="font-family:sans-serif;font-size:14px;color:inherit;line-height:1.6">
                                    @((MarkupString)_htmlBody)
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- ── Statistics ─────────────────────────────────────────────── -->
        <MudTabPanel Text="Statistics" Icon="@Icons.Material.Filled.BarChart">
            <MudGrid Spacing="3">
                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.subtitle1">Field Statistics</MudText></CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                Fill in the numbers for this reporting period. Click Save to persist.
                            </MudText>
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="6">
                                    <!-- FIX: use ValueChanged to trigger dirty flag, not TextChanged -->
                                    <MudNumericField T="int?" Value="_eventsHeld"
                                                     ValueChanged="@(v => { _eventsHeld = v; MarkDirty(); })"
                                                     Label="Events held" Variant="Variant.Outlined"
                                                     Min="0" HideSpinButtons="false" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" Value="_totalAttendees"
                                                     ValueChanged="@(v => { _totalAttendees = v; MarkDirty(); })"
                                                     Label="Total attendees" Variant="Variant.Outlined"
                                                     Min="0" HideSpinButtons="false" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" Value="_newContacts"
                                                     ValueChanged="@(v => { _newContacts = v; MarkDirty(); })"
                                                     Label="New contacts" Variant="Variant.Outlined"
                                                     Min="0" HideSpinButtons="false" />
                                </MudItem>
                                <MudItem xs="12" sm="6">
                                    <MudNumericField T="int?" Value="_materialsDistributed"
                                                     ValueChanged="@(v => { _materialsDistributed = v; MarkDirty(); })"
                                                     Label="Materials distributed" Variant="Variant.Outlined"
                                                     Min="0" HideSpinButtons="false" />
                                </MudItem>
                            </MudGrid>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                                       StartIcon="@Icons.Material.Filled.Save"
                                       OnClick="ManualSave" Disabled="_saving">
                                @(_saving ? "Saving…" : "Save Statistics")
                            </MudButton>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Elevation="0" Outlined="true">
                        <MudCardHeader>
                            <CardHeaderContent><MudText Typo="Typo.subtitle1">Decision Counts</MudText></CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                                Changes are saved immediately when you adjust a count.
                            </MudText>
                            @foreach (DecisionType dt in Enum.GetValues<DecisionType>())
                            {
                                var count = _decisionCounts.GetValueOrDefault(dt, 0);
                                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                                    <MudText Typo="Typo.body2" Style="min-width:180px">@dt</MudText>
                                    <MudNumericField T="int" Value="count"
                                                     ValueChanged="@(v => UpsertDecision(dt, v))"
                                                     Variant="Variant.Outlined" Min="0"
                                                     HideSpinButtons="false" Margin="Margin.Dense"
                                                     Style="max-width:120px" />
                                </MudStack>
                            }
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- ── People Groups ──────────────────────────────────────────── -->
        <MudTabPanel Text="@($"People Groups ({_peopleGroups.Count})")" Icon="@Icons.Material.Filled.Groups">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1">People Groups Reached</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="OpenAddPeopleGroupDialog">Add People Group</MudButton>
            </MudStack>

            @if (!_peopleGroups.Any())
            {
                <EmptyState Title="No people groups recorded" Icon="@Icons.Material.Outlined.Groups"
                            Description="Add the people groups reached during this mission." />
            }
            else
            {
                <MudTable T="PeopleGroupReachedDto" Items="_peopleGroups" Dense="true" Hover="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>JP Code</MudTh><MudTh>People Group</MudTh><MudTh>Country</MudTh>
                        <MudTh>Language</MudTh><MudTh>Est. Reached</MudTh><MudTh Style="width:60px"></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.JpCode</MudTd>
                        <MudTd><b>@context.PeopleGroupName</b></MudTd>
                        <MudTd>@context.Country</MudTd>
                        <MudTd>@(context.Language ?? "—")</MudTd>
                        <MudTd>@(context.EstimatedReached.HasValue ? context.EstimatedReached.Value.ToString("N0") : "—")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemovePeopleGroup(context))" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- ── Prayer Points ──────────────────────────────────────────── -->
        <MudTabPanel Text="@($"Prayer Points ({_prayerPoints.Count})")" Icon="@Icons.Material.Filled.VolunteerActivism">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.subtitle1">Prayer Points</MudText>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small"
                           OnClick="OpenAddPrayerPointDialog">Add Prayer Point</MudButton>
            </MudStack>

            @if (!_prayerPoints.Any())
            {
                <EmptyState Title="No prayer points yet" Icon="@Icons.Material.Outlined.VolunteerActivism"
                            Description="Add prayer requests linked to this field report." />
            }
            else
            {
                @foreach (var pp in _prayerPoints)
                {
                    <MudPaper Elevation="0" Class="pa-3 mb-2" Style="border:1px solid var(--mud-palette-divider);border-radius:6px">
                        <MudStack Row="true" AlignItems="AlignItems.Start">
                            <div style="flex:1">
                                <MudText Typo="Typo.body1"><b>@pp.Title</b></MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@pp.Detail</MudText>
                                @if (pp.Status == PrayerStatus.Answered)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">Answered</MudChip>
                                }
                            </div>
                            <MudStack Row="true">
                                @if (pp.Status == PrayerStatus.Active)
                                {
                                    <MudTooltip Text="Mark answered">
                                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small"
                                                       Color="Color.Success" OnClick="@(() => MarkPrayerAnswered(pp))" />
                                    </MudTooltip>
                                }
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                               Color="Color.Error" OnClick="@(() => DeletePrayerPoint(pp))" />
                            </MudStack>
                        </MudStack>
                    </MudPaper>
                }
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private string _title = string.Empty, _htmlBody = string.Empty, _location = string.Empty;
    private DateTime? _reportDate = DateTime.Today;
    private ReportLanguage _language = ReportLanguage.English;

    // FIX: these are bound with ValueChanged, not TextChanged
    private int? _eventsHeld, _totalAttendees, _newContacts, _materialsDistributed;

    private bool _loading = true, _saving, _isDirty;
    private string? _error;
    private DateTime? _lastSaved;
    private Timer? _saveTimer;
    private MissionReportDetailDto? _report;
    private int _activeTab = 0;

    private Dictionary<DecisionType, int> _decisionCounts = new();
    private List<PeopleGroupReachedDto>   _peopleGroups   = new();
    private List<PrayerPointDto>          _prayerPoints   = new();

    protected override async Task OnInitializedAsync()
    {
        var res = await Api.GetReportAsync(Id);
        if (res.Data is null)
        {
            _error = res.Errors.FirstOrDefault() ?? "Report not found.";
            _loading = false;
            return;
        }
        _report = res.Data;

        if (_report.Status == ReportStatus.Approved)
        {
            Nav.NavigateTo($"/reports/{Id}", replace: true);
            return;
        }

        _title    = _report.Title;
        _htmlBody = _report.HtmlBody;
        _location = _report.Location ?? string.Empty;
        _reportDate = _report.ReportDate.ToDateTime(TimeOnly.MinValue);
        _language   = _report.Language;

        // FIX: load existing stats values so spinners show current values
        _eventsHeld           = _report.EventsHeld;
        _totalAttendees       = _report.TotalAttendees;
        _newContacts          = _report.NewContacts;
        _materialsDistributed = _report.MaterialsDistributed;

        _decisionCounts = _report.Decisions.ToDictionary(d => d.DecisionType, d => d.Count);
        _peopleGroups   = _report.PeopleGroups.ToList();
        _prayerPoints   = _report.PrayerPoints.ToList();

        _loading = false;

        // Auto-save timer — 2 second debounce
        _saveTimer = new Timer(2000) { AutoReset = false };
        _saveTimer.Elapsed += (_, _) => InvokeAsync(AutoSave);
    }

    // FIX: renamed from OnTextChanged — called by @bind-Value:after and ValueChanged lambdas
    private void MarkDirty()
    {
        _isDirty = true;
        _saveTimer?.Stop();
        _saveTimer?.Start();
        StateHasChanged();
    }

    private async Task AutoSave()
    {
        if (!_isDirty || _saving) return;
        await SaveCore();
    }

    private async Task ManualSave()
    {
        _saveTimer?.Stop();
        await SaveCore();
    }

    private async Task SaveCore()
    {
        _saving = true; StateHasChanged();
        var res = await Api.UpdateReportAsync(Id, new UpdateReportRequest
        {
            Id                   = Id,
            Title                = string.IsNullOrWhiteSpace(_title) ? "Untitled" : _title.Trim(),
            ReportDate           = DateOnly.FromDateTime(_reportDate ?? DateTime.Today),
            Location             = _location.NullIfEmpty(),
            Language             = _language,
            HtmlBody             = _htmlBody,
            EventsHeld           = _eventsHeld,
            TotalAttendees       = _totalAttendees,
            NewContacts          = _newContacts,
            MaterialsDistributed = _materialsDistributed
        });
        _saving = false;
        if (res.Success) { _isDirty = false; _lastSaved = DateTime.Now; }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Save failed.", Severity.Error);
        StateHasChanged();
    }

    private async Task SubmitReport()
    {
        if (_isDirty) await ManualSave();
        var res = await Api.SubmitReportAsync(Id);
        if (res.Success) { Snackbar.Add("Report submitted for approval.", Severity.Success); Nav.NavigateTo("/reports"); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }

    // ── Decision Counts ──────────────────────────────────────────────────────
    private async Task UpsertDecision(DecisionType dt, int count)
    {
        _decisionCounts[dt] = count;
        var res = await Api.UpsertDecisionCountAsync(Id, new UpsertDecisionCountRequest { DecisionType = dt, Count = count });
        if (!res.Success) Snackbar.Add(res.Errors.FirstOrDefault() ?? "Could not save decision count.", Severity.Error);
    }

    // ── People Groups ────────────────────────────────────────────────────────
    private async Task OpenAddPeopleGroupDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var d = DialogService.Show<AddPeopleGroupDialog>("Add People Group",
            new DialogParameters { ["ReportId"] = Id }, options);
        var result = await d.Result;
        if (!result.Canceled && result.Data is PeopleGroupReachedDto pg) _peopleGroups.Add(pg);
    }

    private async Task RemovePeopleGroup(PeopleGroupReachedDto pg)
    {
        var res = await Api.RemovePeopleGroupAsync(Id, pg.Id);
        if (res.Success) _peopleGroups.Remove(pg);
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }

    // ── Prayer Points ────────────────────────────────────────────────────────
    private async Task OpenAddPrayerPointDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var d = DialogService.Show<AddPrayerPointDialog>("Add Prayer Point",
            new DialogParameters { ["ReportId"] = Id }, options);
        var result = await d.Result;
        if (!result.Canceled && result.Data is PrayerPointDto pp) _prayerPoints.Add(pp);
    }

    private async Task MarkPrayerAnswered(PrayerPointDto pp)
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
        var d = DialogService.Show<MarkAnsweredDialog>("Mark as Answered",
            new DialogParameters { ["PrayerPointId"] = pp.Id }, options);
        var result = await d.Result;
        if (!result.Canceled && result.Data is PrayerPointDto updated)
        {
            var idx = _prayerPoints.FindIndex(x => x.Id == pp.Id);
            if (idx >= 0) _prayerPoints[idx] = updated;
            Snackbar.Add("Marked as answered.", Severity.Success);
        }
    }

    private async Task DeletePrayerPoint(PrayerPointDto pp)
    {
        var res = await Api.DeletePrayerPointAsync(pp.Id);
        if (res.Success) { _prayerPoints.Remove(pp); Snackbar.Add("Deleted.", Severity.Success); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }

    public void Dispose() { _saveTimer?.Stop(); _saveTimer?.Dispose(); }
}
