@page "/reports"
@inject ApiClient Api
@inject AppState AppState
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Field Reports</MudText><MudSpacer />
    @if (AppState.CanWrite) { <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EditNote" OnClick="CreateReport">New Report</MudButton> }
</MudStack>
<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudSelect T="string" @bind-Value="_statusFilter" Label="Status" Variant="Variant.Outlined" Clearable="true">
            <MudSelectItem Value="@("Draft")">Draft</MudSelectItem>
            <MudSelectItem Value="@("Submitted")">Submitted</MudSelectItem>
            <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
            <MudSelectItem Value="@("ReturnedForRevision")">Returned for revision</MudSelectItem>
        </MudSelect>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudTextField @bind-Value="_search" Label="Search title, location, author" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" DebounceInterval="350" TextChanged="@(_ => _table?.ReloadServerData())" />
    </MudItem>
</MudGrid>
<MudTable T="MissionReportListDto" ServerData="ServerReload" @ref="_table" Hover="true" Dense="true" OnRowClick="@((TableRowClickEventArgs<MissionReportListDto> e) => OpenReport(e.Item))">
    <HeaderContent><MudTh>Title</MudTh><MudTh>Date</MudTh><MudTh>Location</MudTh><MudTh>Author</MudTh><MudTh>Decisions</MudTh><MudTh>Status</MudTh><MudTh Style="width:80px"></MudTh></HeaderContent>
    <RowTemplate>
        <MudTd><MudText Typo="Typo.body2"><b>@context.Title</b></MudText></MudTd>
        <MudTd>@context.ReportDate.ToString("yyyy-MM-dd")</MudTd>
        <MudTd>@(context.Location ?? "—")</MudTd><MudTd>@context.AuthorName</MudTd>
        <MudTd>@if (context.DecisionTotal > 0) { <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">@context.DecisionTotal</MudChip> } else { <MudText Color="Color.Secondary">—</MudText> }</MudTd>
        <MudTd><ReportStatusChip Status="@context.Status" /></MudTd>
        <MudTd @onclick:stopPropagation="true" Style="white-space:nowrap">
            @if (context.Status != ReportStatus.Approved && AppState.CanWrite) { <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => Nav.NavigateTo($"/reports/{context.Id}/edit"))" /> }
            @if (context.Status == ReportStatus.Submitted && AppState.IsFinanceOrAdmin) { <MudTooltip Text="Approve"><MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" OnClick="@(() => ApproveReport(context))" /></MudTooltip> }
            @if (context.Status == ReportStatus.Draft && AppState.CanWrite) { <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteReport(context))" /> }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><EmptyState Title="No field reports yet" Icon="@Icons.Material.Outlined.Article"><ActionContent>@if (AppState.CanWrite) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateReport">New Report</MudButton> }</ActionContent></EmptyState></NoRecordsContent>
    <LoadingContent><LoadingSkeleton Rows="5" /></LoadingContent>
    <PagerContent><MudTablePager PageSizeOptions="new int[]{25,50}" /></PagerContent>
</MudTable>

@code {
    private MudTable<MissionReportListDto>? _table;
    private string _statusFilter = string.Empty, _search = string.Empty;

    private async Task<TableData<MissionReportListDto>> ServerReload(TableState state, CancellationToken ct)
    {
        ReportStatus? status = _statusFilter switch { "Draft" => ReportStatus.Draft, "Submitted" => ReportStatus.Submitted, "Approved" => ReportStatus.Approved, "ReturnedForRevision" => ReportStatus.ReturnedForRevision, _ => null };
        var res = await Api.GetReportsAsync(new PaginationParams { Page = state.Page + 1, PageSize = state.PageSize, Search = _search }, status: status);
        return new TableData<MissionReportListDto> { Items = res.Data?.Items ?? Array.Empty<MissionReportListDto>(), TotalItems = res.Data?.TotalCount ?? 0 };
    }

    private async Task CreateReport()
    {
        var res = await Api.CreateReportAsync(new CreateReportRequest { Title = $"Field Report {DateTime.Today:yyyy-MM-dd}", ReportDate = DateOnly.FromDateTime(DateTime.Today), Language = ReportLanguage.English });
        if (res.Success && res.Data != default) Nav.NavigateTo($"/reports/{res.Data}/edit");
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Could not create report.", Severity.Error);
    }

    private void OpenReport(MissionReportListDto r) => Nav.NavigateTo(r.Status is ReportStatus.Draft or ReportStatus.ReturnedForRevision ? $"/reports/{r.Id}/edit" : $"/reports/{r.Id}");

    private async Task ApproveReport(MissionReportListDto r)
    {
        var res = await Api.ApproveReportAsync(r.Id);
        if (res.Success) { Snackbar.Add("Report approved.", Severity.Success); await _table!.ReloadServerData(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }

    private async Task DeleteReport(MissionReportListDto r)
    {
        var p = new DialogParameters { ["Title"] = "Delete report", ["Message"] = $"Delete '{r.Title}'?" };
        var confirm = DialogService.Show<ConfirmDialog>("", p);
        if ((await confirm.Result).Canceled) return;
        var res = await Api.DeleteReportAsync(r.Id);
        if (res.Success) { Snackbar.Add("Deleted.", Severity.Success); await _table!.ReloadServerData(); }
        else Snackbar.Add(res.Errors.FirstOrDefault() ?? "Error.", Severity.Error);
    }
}
